
@{
    ViewBag.Title = "Registered Users";
    Layout = "_BackendLayout";

    var getAllUsers = await _Context.Users.ToListAsync();
}

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            
        </div>
    </div>
</div>

        <!-- Static Table End -->
        <section class="content">
    
            <div class="card">
                <div class="card-body">
                    <table id="usersTable" class="table table-bordered table-striped">
                        <thead>
                        <tr>
                            <th>No</th>
                            <th>Email</th>
                            <th>Name</th>
                            <th>Phone No</th>
                            <th>Country</th>
                            <th>Status</th>
                            <th>Last Login</th>
                            <th>Action</th>
                        </tr>
                        </thead>
                        <tbody>
                        <!-- Data will be loaded dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>
          
        </section>

        @section Scripts {
            <script>
                $(document).ready(function () {
                    $('#usersTable').DataTable({
                        processing: true,
                        serverSide: true,
                        ajax: {
                            url: '/Account/GetPaginatedAllUsers', // Correct endpoint
                            type: 'GET',
                            data: function (d) {
                                // Pass additional parameters if needed
                                d.searchValue = d.search.value; // Attach the search value
                            },
                            error: function (xhr, error, thrown) {
                                console.error('Error in DataTables AJAX request:', error);
                                console.error('Response:', xhr.responseText);
                            }
                        },
                        columns: [
                            {
                                data: null,
                                render: function (data, type, row, meta) {
                                    return meta.row + 1; // Auto-increment row number
                                }
                            },
                            { data: 'email' },
                            { data: 'name' },
                            { data: 'phoneNo' },
                            { data: 'country' },
                            {
                                data: 'status',
                                render: function (data) {
                                    const badgeClass = data === "Confirmed" ? "badge-success" : "badge-danger";
                                    return `<span class="badge ${badgeClass}">${data}</span>`;
                                }
                            },
                            { data:'lastLogin' },
                            {
                                data: 'id',
                                render: function (data, type, row) {
                                    return `
                        <div class="btn-group">
                            <button type="button" class="btn btn-success" title="Confirm">
                                <i class="fa fa-check"></i>
                            </button>
                            <button type="button" class="btn btn-danger" title="Disable">
                                <i class="fa fa-stop"></i>
                            </button>
                        </div>
                    `;
                                }
                            }
                        ]
                    });
                });


            </script>
        }
        
        