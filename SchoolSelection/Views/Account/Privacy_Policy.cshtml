@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Privacy Policy for the College Selection System." />
    <title>Privacy Policy | Decide Confidently™</title>
    <link rel="icon" href="~/images/schoolselection.jpeg" type="image/png" />

    <!-- Bootstrap CSS -->
    <link
        href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
        rel="stylesheet"
    />
    <!-- Font Awesome -->
    <link
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
        rel="stylesheet"
    />

    <style>
        :root {
            --primary: #2c3e50;
            --secondary: #3498db;
            --accent: #e74c3c;
            --light: #ecf0f1;
            --dark: #2c3e50;
            --success: #27ae60;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
            color: var(--dark);
            line-height: 1.6;
            margin: 0;
            padding: 0;
        }
        .nav-link {
            color: var(--dark);
            font-weight: 500;
        }
        .nav-link:hover {
            color: var(--secondary);
        }
        .btn-primary {
            background-color: var(--secondary);
            border-color: var(--secondary);
        }
        .btn-primary:hover {
            background-color: #2980b9;
            border-color: #2980b9;
        }
        .btn-outline-primary {
            color: var(--secondary);
            border-color: var(--secondary);
        }
        .btn-outline-primary:hover {
            background-color: var(--secondary);
            color: white;
        }
        footer {
            background-color: var(--dark);
            color: white;
            padding: 2rem 0;
        }
        a {
            color: var(--secondary);
        }
        a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
<!-- Navigation -->
<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
    <div class="container">
        <a class="navbar-brand font-weight-bold" href="#" style="color: var(--secondary);">
            <img src="~/images/schoolselection.jpeg" alt="Logo" height="40" class="mr-2" />
            Decide Confidently™
        </a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="College" asp-action="Index">College Selection Tool</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="Events">Events</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="About_Us">About Us</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="community" asp-controller="Account">Community</a>
                </li>
                <li class="nav-item ml-lg-3">
                    <a class="btn btn-outline-primary" href="/Account/Register">Register</a>
                </li>
                <li class="nav-item ml-lg-2">
                    <a class="btn btn-primary" href="/Account/Login">Login</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- Privacy Policy Content -->
<section class="py-5">
    <div class="container">
        <h1 class="text-secondary text-center mb-4">Privacy Policy</h1>
        <div class="card shadow-sm mb-5">
            <div class="card-body">

                <section>
                    <h2 class="text-secondary">1. Introduction</h2>
                    <p>
                        At Decide Confidently™ (“we,” “us,” or “our”), we respect your privacy and are committed to protecting your personal data. This Privacy Policy explains how we collect, use, store, and share information when you visit or use our College Selection System.
                    </p>
                </section>

                <section class="mt-4">
                    <h3 class="text-secondary">2. Information We Collect</h3>
                    <ul class="pl-3">
                        <li><strong>Account Information:</strong> Name, email address, password, and profile settings when you register.</li>
                        <li><strong>Usage Data:</strong> Pages visited, search terms entered, time stamps, device/browser details.</li>
                        <li><strong>Preferences:</strong> College criteria, saved lists, filters, and selections you make.</li>
                        <li><strong>Communications:</strong> Emails and messages you send through our platform.</li>
                    </ul>
                </section>

                <section class="mt-4">
                    <h3 class="text-secondary">3. How We Use Your Information</h3>
                    <ul class="pl-3">
                        <li><strong>Provide Services:</strong> To run and improve the College Selection Tool and related features.</li>
                        <li><strong>Personalization:</strong> To tailor recommendations, content, and notifications to your preferences.</li>
                        <li><strong>Communication:</strong> To respond to inquiries, send updates, and transactional messages.</li>
                        <li><strong>Analytics:</strong> To understand usage patterns and enhance user experience.</li>
                        <li><strong>Compliance:</strong> To fulfill legal obligations and protect our rights.</li>
                    </ul>
                </section>

                <section class="mt-4">
                    <h3 class="text-secondary">4. Cookies &amp; Tracking</h3>
                    <p>
                        We use cookies and similar technologies to collect information about your browsing behavior. You can manage or disable cookies via your browser settings, but this may affect functionality.
                    </p>
                </section>

                <section class="mt-4">
                    <h3 class="text-secondary">5. Sharing &amp; Disclosure</h3>
                    <ul class="pl-3">
                        <li><strong>Third-Party Service Providers:</strong> We may share data with hosting, analytics, email, and support vendors.</li>
                        <li><strong>Legal Requirements:</strong> We may disclose information to comply with legal processes or to protect our rights.</li>
                        <li><strong>Business Transfers:</strong> If we merge or sell assets, user data may be transferred under confidentiality terms.</li>
                    </ul>
                </section>

                <section class="mt-4">
                    <h3 class="text-secondary">6. Third-Party Links</h3>
                    <p>
                        Our site may link to external sites for your convenience. We are not responsible for their content or privacy practices. Review their policies before sharing personal information.
                    </p>
                </section>

                <section class="mt-4">
                    <h3 class="text-secondary">7. Data Security</h3>
                    <p>
                        We implement industry-standard security measures (encryption, access controls) to protect your data. However, no system is impenetrable—use caution when sharing sensitive information.
                    </p>
                </section>

                <section class="mt-4">
                    <h3 class="text-secondary">8. Data Retention</h3>
                    <p>
                        We retain your personal data only as long as necessary to provide services, comply with legal obligations, or resolve disputes.
                    </p>
                </section>

                <section class="mt-4">
                    <h3 class="text-secondary">9. Children’s Privacy</h3>
                    <p>
                        Our services are not intended for users under 16 without parental consent. We do not knowingly collect data from minors. Contact us if you believe we have done so.
                    </p>
                </section>

                <section class="mt-4">
                    <h3 class="text-secondary">10. International Transfers</h3>
                    <p>
                        Your data may be stored or processed outside your country. We take steps to ensure adequate protections in accordance with applicable laws.
                    </p>
                </section>

                <section class="mt-4">
                    <h3 class="text-secondary">11. Your Rights</h3>
                    <p>
                        Depending on your jurisdiction, you may have rights to access, correct, delete, or restrict processing of your personal data. To exercise your rights, contact us as below.
                    </p>
                </section>

                <section class="mt-4">
                    <h3 class="text-secondary">12. Changes to This Policy</h3>
                    <p>
                        We may update this Privacy Policy at any time. The “Last Updated” date below will reflect changes. Continued use after updates constitutes acceptance.
                    </p>
                </section>

                <hr class="my-4" />

                <section>
                    <h5>Contact Us</h5>
                    <p>
                        For privacy questions or data requests, please email
                        <a href="mailto:decideconfidently@froootpizza.com" class="font-weight-bold">
                            decideconfidently@froootpizza.com
                        </a>.
                    </p>
                    <p class="text-muted small mb-0">
                        <strong>Last Updated:</strong> June 28, 2025
                    </p>
                </section>

            </div>
        </div>
    </div>
</section>

<!-- Footer -->
<footer>
    <div class="container">
        <div class="row">
            <div class="col-lg-4 mb-4 mb-lg-0">
                <h5>Decide Confidently™</h5>
                <p>Helping students make the best college decisions since 2015.</p>
            </div>
            <div class="col-lg-2 col-md-6 mb-4 mb-md-0">
                <h5>Quick Links</h5>
                <ul class="list-unstyled">
                    <li><a class="text-white" asp-controller="College" asp-action="Index">College Selection Tool</a></li>
                    <li><a class="text-white" asp-action="About_Us">About Us</a></li>
                    <li><a class="text-white" asp-action="Terms_Conditions">Terms & Condition</a></li>
                    <li><a class="text-white" asp-action="Privacy_Policy">Privacy Policy</a></li>
                </ul>
            </div>
            <div class="col-lg-3 col-md-6 mb-4 mb-md-0">
                <h5>Connect</h5>
                <ul class="list-unstyled">
                    <li><a class="text-white" href="https://www.facebook.com/profile.php?id=100066758075620"><i class="fab fa-facebook-f mr-2"></i>Facebook</a></li>
                    <li><a class="text-white" href="https://instagram.com/froootpizza/"><i class="fab fa-instagram mr-2"></i>Instagram</a></li>
                </ul>
            </div>
            <div class="col-lg-3">
                <h5>Contact Us</h5>
                <ul class="list-unstyled">
                    <li><i class="fas fa-envelope mr-2"></i>decideconfidently@froootpizza.com</li>
                </ul>
            </div>
        </div>
        <hr class="bg-white my-4" />
        <div class="text-center">
            <p class="mb-0">&copy; @DateTime.Now.Year Decide Confidently™. All rights reserved.</p>
        </div>
    </div>
</footer>

<!-- Bootstrap JS & dependencies -->
<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
