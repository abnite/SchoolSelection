@model ChangePasswordViewModel

@{
    ViewBag.Title = "Change Password";
    Layout = "_BackendLayout";
}

<section class="content">
    <div class="container">
        <!-- Page Header -->
        <div class="row">
            <div class="col-md-12 text-center my-5">
                <h1 class="display-4">Change Password</h1>
                <p class="lead text-muted">For your account security, please ensure your new password meets the requirements.</p>
                <hr style="width: 50%; margin: auto;">
            </div>
        </div>

        <!-- Change Password Form -->
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="card shadow-lg">
                    <div class="card-header bg-primary text-white text-center">
                        <h3 class="card-title">Update Your Password</h3>
                    </div>
                    <div class="card-body">
                        <form asp-action="ChangePassword" method="post">
                            <!-- Old Password -->
                            <div class="form-group">
                                <label asp-for="OldPassword" class="font-weight-bold">Old Password</label>
                                <input asp-for="OldPassword" class="form-control form-control-lg" type="password" placeholder="Enter old password" />
                                <span asp-validation-for="OldPassword" class="text-danger"></span>
                            </div>

                            <!-- New Password -->
                            <div class="form-group">
                                <label asp-for="NewPassword" class="font-weight-bold">New Password</label>
                                <input asp-for="NewPassword" class="form-control form-control-lg" type="password" placeholder="Enter new password" />
                                <span asp-validation-for="NewPassword" class="text-danger"></span>
                            </div>

                            <!-- Confirm Password -->
                            <div class="form-group">
                                <label asp-for="ConfirmPassword" class="font-weight-bold">Confirm Password</label>
                                <input asp-for="ConfirmPassword" class="form-control form-control-lg" type="password" placeholder="Re-enter new password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>

                            <!-- Submit Button -->
                            <div class="text-center mt-4">
                                <button type="submit" class="btn btn-success btn-lg px-5">Change Password</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
