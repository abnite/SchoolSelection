@{
    ViewBag.Title = "Community — Decide Confidently";
    Layout = "_LoginLayout";
}

<!-- Page hero -->
<div class="page-hero">
  <div class="container hero-content text-center">
    <p style="font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;opacity:.7;margin-bottom:.5rem">
      Stronger Together
    </p>
    <h1 class="display-4 font-weight-bold mb-3">Our Community in Action</h1>
    <p class="lead mb-0" style="opacity:.85;max-width:560px;margin:0 auto">
      Empowering students through HBCU tours and career exploration resources
      to help them Decide Confidently.
    </p>
  </div>
</div>

<section style="padding:4rem 0;background:var(--surface)">
  <div class="container">

    <!-- Section header -->
    <div class="text-center mb-5">
      <h2 class="section-title">HBCU 50 Student Tour &mdash; March 2023</h2>
      <p class="section-subtitle mt-2" style="max-width:620px;margin:0 auto">
        OIC Counselor and Lead Case Manager Sheilah Wright and Chaperone Barry shared
        Decide Confidently gear and tools for success with students exploring 20 HBCUs.
      </p>
    </div>

    <!-- Photo pair -->
    <div class="row mb-5">
      <div class="col-md-6 mb-4 animate-up">
        <div class="card gallery-card h-100">
          <div style="overflow:hidden;border-radius:var(--r-lg) var(--r-lg) 0 0;height:280px">
            <img src="~/images/OIC.jpeg"
                 style="width:100%;height:100%;object-fit:cover"
                 alt="Students with bus and chaperones">
          </div>
          <div class="card-body" style="padding:1.25rem!important">
            <p style="font-size:.875rem;color:var(--text-muted);margin:0;line-height:1.65">
              Ready to roll! Our team en route during the PACAC conference.
            </p>
          </div>
        </div>
      </div>
      <div class="col-md-6 mb-4 animate-up">
        <div class="card gallery-card h-100">
          <div style="overflow:hidden;border-radius:var(--r-lg) var(--r-lg) 0 0;height:280px">
            <img src="~/images/OIC_Counselor.jpeg"
                 style="width:100%;height:100%;object-fit:cover"
                 alt="Swag distribution">
          </div>
          <div class="card-body" style="padding:1.25rem!important">
            <p style="font-size:.875rem;color:var(--text-muted);margin:0;line-height:1.65">
              Sharing Froootpizza Decide Confidently backpacks and college planning kits at OIC Montgomery County.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Video -->
    <div class="row mb-5">
      <div class="col-lg-8 mx-auto">
        <div class="card animate-up">
          <div class="card-body text-center" style="padding:2rem!important">
            <h4 style="font-weight:800;letter-spacing:-.03em;margin-bottom:1.25rem">
              <i class="fas fa-play-circle mr-2" style="color:var(--primary)"></i>
              HBCU Tour Highlights
            </h4>
            <div style="border-radius:var(--r-lg);overflow:hidden;box-shadow:var(--shadow-lg);margin-bottom:1rem">
              <video controls style="width:100%;background:#000">
                <source src="~/images/OIC_video.mp4" type="video/mp4">
                Your browser does not support the video tag.
              </video>
            </div>
            <p style="font-size:.875rem;color:var(--text-muted);margin:0">
              Catch a glimpse of the life-changing experience as students visit campuses,
              meet mentors, and plan for success.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Testimonials -->
    <div class="text-center mb-4">
      <h3 class="section-title">What Participants Say</h3>
      <p class="section-subtitle mt-1">Real voices from our community</p>
    </div>

    <div class="row">
      @foreach (var (quote, who) in new[] {
        ("The tour opened my eyes to HBCU opportunities I never knew existed.",
         "Tour Participant"),
        ("The Decide Confidently materials helped me narrow down my college choices.",
         "High School Senior"),
        ("This program provides invaluable guidance for first-generation college students.",
         "School Counselor")
      })
      {
        <div class="col-md-4 mb-4 animate-up">
          <div class="testimonial-card h-100">
            <blockquote class="blockquote mb-0">
              <p style="position:relative;z-index:1;padding-top:.5rem">"@quote"</p>
              <footer class="blockquote-footer">@who</footer>
            </blockquote>
          </div>
        </div>
      }
    </div>

    <!-- CTA -->
    <div class="text-center mt-5">
      <div style="background:var(--primary-light);border-radius:var(--r-xl);padding:2.5rem;max-width:560px;margin:0 auto">
        <h4 style="font-weight:800;letter-spacing:-.03em;margin-bottom:.75rem">Join Our Community</h4>
        <p style="font-size:.875rem;color:var(--text-muted);margin-bottom:1.25rem;line-height:1.65">
          Become part of a growing community of students and counselors making confident college decisions together.
        </p>
        <a href="/Account/Register" class="btn btn-primary">
          <i class="fas fa-user-plus mr-2"></i> Register Now — It's Free
        </a>
      </div>
    </div>

  </div>
</section>
