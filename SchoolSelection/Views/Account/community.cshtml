@{
    ViewBag.Title = "Community - Decide Confidently";
    Layout = "_LoginLayout";
}

<!-- Hero Section -->
<section class="hero-section py-5 bg-light">
    <div class="container text-center">
        <h1 class="display-4 font-weight-bold mb-3">Our Community in Action</h1>
        <p class="lead">Empowering students through HBCU tours and career exploration resources to help them Decide Confidently.</p>
    </div>
</section>

<!-- Event Highlight Section -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="font-weight-bold">HBCU 50 Student Tour – March 2023</h2>
            <p class="lead">OIC Counselor and Lead Case Manager Sheilah Wright and Chaperone Barry shared Decide Confidently gear and tools for success with students exploring 20 HBCUs.</p>
        </div>

        <!-- Image Gallery -->
        <div class="row">
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm h-100">
                    <img src="~/images/OIC.jpeg" class="card-img-top" alt="Students with bus and chaperones" style="height: 300px; object-fit: cover;">

                    <div class="card-body">
                        <p class="card-text">Ready to roll! Our team en route during the PACAC conference.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm h-100">
                    <img src="~/images/OIC_Counselor.jpeg" class="card-img-top" alt="Froootpizza swag distribution" style="height: 300px; object-fit: cover;">
                    <div class="card-body">
                        <p class="card-text">Sharing Froootpizza Decide Confidently backpacks and college planning kits at OIC Montgomery County.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Video Section -->
        <div class="row my-5">
            <div class="col-lg-8 mx-auto text-center">
                <div class="embed-responsive embed-responsive-16by9 shadow mb-4">
                    <video class="embed-responsive-item" controls>
                        <source src="~/images/OIC_video.mp4" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                </div>
                <h3>HBCU Tour Highlights</h3>
                <p>Catch a glimpse of the life-changing experience as students visit campuses, meet mentors, and plan for success.</p>
            </div>
        </div>

        <!-- Testimonials -->
        <div class="row">
            <div class="col-lg-10 mx-auto">
                <div class="card bg-light border-0">
                    <div class="card-body p-5">
                        <h3 class="text-center mb-4">What Participants Say</h3>
                        <div class="row">
                            <div class="col-md-4 mb-4">
                                <div class="card h-100 shadow-sm">
                                    <div class="card-body">
                                        <blockquote class="blockquote mb-0">
                                            <p>"The tour opened my eyes to HBCU opportunities I never knew existed."</p>
                                            <footer class="blockquote-footer">Tour Participant</footer>
                                        </blockquote>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-4">
                                <div class="card h-100 shadow-sm">
                                    <div class="card-body">
                                        <blockquote class="blockquote mb-0">
                                            <p>"The Decide Confidently materials helped me narrow down my college choices."</p>
                                            <footer class="blockquote-footer">High School Senior</footer>
                                        </blockquote>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-4">
                                <div class="card h-100 shadow-sm">
                                    <div class="card-body">
                                        <blockquote class="blockquote mb-0">
                                            <p>"This program provides invaluable guidance for first-generation college students."</p>
                                            <footer class="blockquote-footer">School Counselor</footer>
                                        </blockquote>
                                    </div>
                                </div>
                            </div>
                        </div> <!-- End testimonials row -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
