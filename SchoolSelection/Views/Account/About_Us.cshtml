@{
    ViewBag.Title = "About Us - Decide Confidently";
    Layout = "_LoginLayout";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container hero-content">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <h1 class="display-4 font-weight-bold mb-4">About Decide Confidently</h1>
                <p class="lead mb-4">Your trusted companion for college selection decisions</p>
            </div>
        </div>
    </div>
</section>

<!-- Mission Content -->
<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <!-- Welcome Message -->
                <div class="card shadow-sm border-0 mb-5">
                    <div class="card-body p-4 p-md-5">
                        <div class="text-center mb-4">
                            <img src="~/images/schoolselection.jpeg" alt="Decide Confidently Logo" height="80" class="mb-3">
                            <h2 class="font-weight-bold">Welcome to Your College Selection Journey</h2>
                        </div>
                        
                        <p class="lead text-center mb-4">
                            Your companion to help you navigate the complexities of choosing the right college fit.
                        </p>
                        
                        <div class="text-center">
                            <p class="mb-0">
                                <i class="fas fa-check-circle text-primary me-2"></i>
                                You should have an initial list of colleges identified in order to begin
                            </p>
                        </div>
                    </div>
                </div>
                
                <!-- What We Do -->
                <div class="row mb-5">
                    <div class="col-md-6 mb-4 mb-md-0">
                        <div class="card h-100 border-0 bg-light">
                            <div class="card-body">
                                <h3 class="card-title text-center mb-4">
                                    <i class="fas fa-university text-primary me-2"></i>Our Purpose
                                </h3>
                                <p>
                                    Decide Confidently is your one-stop resource for all college decision-making needs.
                                </p>
                                <p>
                                    We provide the tools and frameworks to help students and families make informed choices
                                    about higher education.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100 border-0 bg-light">
                            <div class="card-body">
                                <h3 class="card-title text-center mb-4">
                                    <i class="fas fa-bullseye text-primary me-2"></i>Our Approach
                                </h3>
                                <p>
                                    We believe college selection should be methodical, personalized, and confidence-building.
                                </p>
                                <p>
                                    Our tools guide you through each step of the evaluation process to ensure the best possible fit.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Founder's Story -->
                <div class="card shadow-sm border-0 mb-5">
                    <div class="card-body p-4 p-md-5">
                        <h3 class="text-center mb-4">Our Origin Story</h3>
                        <div class="row align-items-center">
                            <div class="col-md-4 text-center mb-4 mb-md-0">
                                <img src="~/images/schoolselection.jpeg" alt="Founder" class="rounded-circle img-fluid" style="max-width: 200px;">
                            </div>
                            <div class="col-md-8">
                                <p>
                                    Decide Confidently was created out of a personal need for better college selection tools.
                                    After navigating the complex college decision process firsthand, our founder recognized
                                    the need for a more systematic approach.
                                </p>
                                <p>
                                    What began as a personal solution has grown into a platform helping thousands of students
                                    make one of the most important decisions of their young lives.
                                </p>
                                <div class="text-center mt-3">
                                    <a href="#" class="btn btn-outline-primary me-2">Read Full Story</a>
                                    <a href="#" class="btn btn-primary">
                                        <i class="fas fa-play me-1"></i> Watch Our Story
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Why It Works -->
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4 p-md-5">
                        <h3 class="text-center mb-4">Why Choose Decide Confidently?</h3>
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <div class="d-flex">
                                    <div class="me-3 text-primary">
                                        <i class="fas fa-check-circle fa-2x"></i>
                                    </div>
                                    <div>
                                        <h5>Personalized Framework</h5>
                                        <p>Tailored to your specific needs and college preferences</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 mb-4">
                                <div class="d-flex">
                                    <div class="me-3 text-primary">
                                        <i class="fas fa-check-circle fa-2x"></i>
                                    </div>
                                    <div>
                                        <h5>Proven Methodology</h5>
                                        <p>Systematic approach developed through years of research</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 mb-4 mb-md-0">
                                <div class="d-flex">
                                    <div class="me-3 text-primary">
                                        <i class="fas fa-check-circle fa-2x"></i>
                                    </div>
                                    <div>
                                        <h5>Comprehensive Resources</h5>
                                        <p>All the tools you need in one place</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex">
                                    <div class="me-3 text-primary">
                                        <i class="fas fa-check-circle fa-2x"></i>
                                    </div>
                                    <div>
                                        <h5>Confidence Building</h5>
                                        <p>Feel assured about your final decision</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>