@{
    ViewBag.Title = "About Us — Decide Confidently";
    Layout = "_LoginLayout";
}

<!-- Page hero -->
<div class="page-hero">
  <div class="container hero-content text-center">
    <p style="font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;opacity:.7;margin-bottom:.5rem">
      Our Story
    </p>
    <h1 class="display-4 font-weight-bold mb-3">About Decide Confidently</h1>
    <p class="lead mb-0" style="opacity:.85;max-width:560px;margin:0 auto">
      Your trusted companion for college selection decisions
    </p>
  </div>
</div>

<!-- Mission section -->
<section style="padding:4rem 0;background:var(--surface)">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-9">

        <!-- Welcome card -->
        <div class="card mb-4 animate-up">
          <div class="card-body text-center" style="padding:2.5rem!important">
            <img src="~/images/schoolselection.jpeg" alt="Logo"
                 style="width:72px;height:72px;border-radius:var(--r);object-fit:cover;margin-bottom:1rem;box-shadow:var(--shadow)">
            <h2 style="font-weight:800;letter-spacing:-.04em;margin-bottom:.75rem">
              Welcome to Your College Selection Journey
            </h2>
            <p style="color:var(--text-muted);font-size:.95rem;max-width:560px;margin:0 auto;line-height:1.75">
              Your companion to help you navigate the complexities of choosing the right college fit.
              You should have an initial list of colleges identified in order to begin.
            </p>
          </div>
        </div>

        <!-- Purpose & Approach cards -->
        <div class="row mb-4">
          <div class="col-md-6 mb-4 animate-up">
            <div class="card h-100">
              <div class="card-body">
                <div class="feature-icon" style="width:52px;height:52px;font-size:1.3rem;margin-bottom:1rem">
                  <i class="fas fa-university"></i>
                </div>
                <h5 style="font-weight:700;margin-bottom:.625rem">Our Purpose</h5>
                <p style="font-size:.875rem;color:var(--text-muted);line-height:1.7;margin:0">
                  Decide Confidently is your one-stop resource for all college decision-making needs.
                  We provide the tools and frameworks to help students and families make informed choices
                  about higher education.
                </p>
              </div>
            </div>
          </div>
          <div class="col-md-6 mb-4 animate-up">
            <div class="card h-100">
              <div class="card-body">
                <div class="feature-icon" style="width:52px;height:52px;font-size:1.3rem;margin-bottom:1rem">
                  <i class="fas fa-bullseye"></i>
                </div>
                <h5 style="font-weight:700;margin-bottom:.625rem">Our Approach</h5>
                <p style="font-size:.875rem;color:var(--text-muted);line-height:1.7;margin:0">
                  We believe college selection should be methodical, personalized, and confidence-building.
                  Our tools guide you through each step of the evaluation process to ensure the best
                  possible fit for your goals.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Origin Story -->
        <div class="card mb-4 animate-up">
          <div class="card-body" style="padding:2.25rem!important">
            <h4 style="font-weight:800;letter-spacing:-.03em;margin-bottom:1.5rem;text-align:center">
              Our Origin Story
            </h4>
            <div class="row align-items-center">
              <div class="col-md-4 text-center mb-4 mb-md-0">
                <img src="~/images/schoolselection.jpeg" alt="Founder"
                     style="width:160px;height:160px;border-radius:50%;object-fit:cover;border:4px solid var(--primary-light);box-shadow:var(--shadow)">
              </div>
              <div class="col-md-8">
                <p style="font-size:.9rem;color:var(--text-muted);line-height:1.8;margin-bottom:.875rem">
                  Decide Confidently was created out of a personal need for better college selection tools.
                  After navigating the complex college decision process firsthand, our founder recognized
                  the need for a more systematic approach.
                </p>
                <p style="font-size:.9rem;color:var(--text-muted);line-height:1.8;margin-bottom:1.25rem">
                  What began as a personal solution has grown into a platform helping thousands of students
                  make one of the most important decisions of their young lives.
                </p>
                <div>
                  <a href="#" class="btn btn-outline-primary btn-sm mr-2">Read Full Story</a>
                  <a href="#" class="btn btn-primary btn-sm">
                    <i class="fas fa-play mr-1"></i> Watch Our Story
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Why choose us -->
        <div class="card animate-up">
          <div class="card-body" style="padding:2.25rem!important">
            <h4 style="font-weight:800;letter-spacing:-.03em;margin-bottom:1.5rem;text-align:center">
              Why Choose Decide Confidently?
            </h4>
            <div class="row">
              @foreach (var (icon, title, body) in new[] {
                ("fa-user-check", "Personalized Framework", "Tailored to your specific needs and college preferences."),
                ("fa-flask", "Proven Methodology", "Systematic approach developed through years of research."),
                ("fa-box-open", "Comprehensive Resources", "All the tools you need in one place."),
                ("fa-shield-alt", "Confidence Building", "Feel assured and informed about your final decision.")
              })
              {
                <div class="col-md-6 mb-4">
                  <div style="display:flex;align-items:flex-start;gap:.875rem">
                    <div style="width:40px;height:40px;border-radius:var(--r-sm);background:var(--primary-light);display:flex;align-items:center;justify-content:center;color:var(--primary);flex-shrink:0;font-size:1rem">
                      <i class="fas @icon"></i>
                    </div>
                    <div>
                      <h6 style="font-weight:700;margin-bottom:.25rem">@title</h6>
                      <p style="font-size:.875rem;color:var(--text-muted);margin:0;line-height:1.6">@body</p>
                    </div>
                  </div>
                </div>
              }
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
