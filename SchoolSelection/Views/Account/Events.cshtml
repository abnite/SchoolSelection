@{
    ViewBag.Title = "Events - Decide Confidently";
    Layout = "_LoginLayout";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container hero-content">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <h1 class="display-4 font-weight-bold mb-4">Expert Panel Discussions</h1>
                <p class="lead mb-4">Gain insider knowledge from top college admissions experts</p>
            </div>
        </div>
    </div>
</section>

<!-- Main Event Section -->
<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 mb-5">
                    <div class="card-body p-4 p-md-5">
                        <div class="text-center mb-4">
                            <h2 class="font-weight-bold">Exclusive Invitation</h2>
                            <!--<div class="badge bg-primary text-white p-2 mt-2 mb-3">
                                <i class="fas fa-calendar-alt me-2"></i>Next Panel: September 2025
                            </div>-->
                        </div>

                        <h3 class="text-center mb-4">Expert Q&A Panel Discussions for College Success!</h3>
                        <p class="lead text-center mb-4">
                            We're thrilled to offer a unique opportunity for your organization to participate in our
                            upcoming Q&A panel discussions, tailored specifically for students and parents navigating
                            the college selection process.
                        </p>

                        <div class="row my-5">
                            <div class="col-md-6 mb-4">
                                <div class="card h-100 border-0 bg-light">
                                    <div class="card-body">
                                        <h4 class="card-title text-center mb-3">
                                            <i class="fas fa-user-graduate text-primary me-2"></i>Meet Our Panelists
                                        </h4>
                                        <ul class="list-unstyled">
                                            <li class="mb-2"><i class="fas fa-check-circle text-primary me-2"></i>Degrees from Ivy League and top-tier institutions</li>
                                            <li class="mb-2"><i class="fas fa-check-circle text-primary me-2"></i>Yale, Stanford, Wesleyan alumni</li>
                                            <li class="mb-2"><i class="fas fa-check-circle text-primary me-2"></i>MIT, University of Pennsylvania graduates</li>
                                            <li><i class="fas fa-check-circle text-primary me-2"></i>Villanova and other prestigious schools</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card h-100 border-0 bg-light">
                                    <div class="card-body">
                                        <h4 class="card-title text-center mb-3">
                                            <i class="fas fa-lightbulb text-primary me-2"></i>You'll Gain
                                        </h4>
                                        <ul class="list-unstyled">
                                            <li class="mb-2"><i class="fas fa-star text-primary me-2"></i>Expertise in college interviews</li>
                                            <li class="mb-2"><i class="fas fa-star text-primary me-2"></i>Admissions strategy insights</li>
                                            <li class="mb-2"><i class="fas fa-star text-primary me-2"></i>Answers to pressing questions</li>
                                            <li><i class="fas fa-star text-primary me-2"></i>Firsthand experiences from successful applicants</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="text-center mt-4">
                            <div class="alert alert-info d-inline-block">
                                <i class="fas fa-info-circle me-2"></i>
                                <strong>March 31st event completed</strong> <!-- – Stay tuned for September 2025 panel!-->
                            </div>
                        </div>
                    </div>
                </div>

