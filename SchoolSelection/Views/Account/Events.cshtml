                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card h-100 shadow-sm">
                            <img src="~/images/Event4.jpeg" class="card-img-top" style="height: 250px; object-fit: cover;" alt="Male student group">
                            <div class="card-body">
                                <p class="card-text">Students bonding during the HBCU tour experience.</p>
                            </div>
