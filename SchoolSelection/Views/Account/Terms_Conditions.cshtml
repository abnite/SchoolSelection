@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Terms and Conditions for the College Selection System to help students choose the best college." />
    <title>Terms and Conditions | Decide Confidently™</title>
    <link rel="icon" href="~/images/schoolselection.jpeg" type="image/png" />

    <!-- Bootstrap CSS -->
    <link
        href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"
        rel="stylesheet"
    />
    <!-- Font Awesome -->
    <link
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
        rel="stylesheet"
    />

    <!-- Custom Theme CSS -->
    <style>
        :root {
            --primary: #2c3e50;
            --secondary: #3498db;
            --accent: #e74c3c;
            --light: #ecf0f1;
            --dark: #2c3e50;
            --success: #27ae60;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
            color: var(--dark);
            line-height: 1.6;
            margin: 0;
            padding: 0;
        }
        .nav-link {
            color: var(--dark);
            font-weight: 500;
        }
        .nav-link:hover {
            color: var(--secondary);
        }
        .btn-primary {
            background-color: var(--secondary);
            border-color: var(--secondary);
        }
        .btn-primary:hover {
            background-color: #2980b9;
            border-color: #2980b9;
        }
        .btn-outline-primary {
            color: var(--secondary);
            border-color: var(--secondary);
        }
        .btn-outline-primary:hover {
            background-color: var(--secondary);
            color: white;
        }
        footer {
            background-color: var(--dark);
            color: white;
            padding: 2rem 0;
        }
        a {
            color: var(--secondary);
        }
        a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
<!-- Navigation -->
<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
    <div class="container">
        <a class="navbar-brand font-weight-bold" href="#" style="color: var(--secondary);">
            <img src="~/images/schoolselection.jpeg" alt="Logo" height="40" class="mr-2" />
            Decide Confidently™
        </a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="College" asp-action="Index">College Selection Tool</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="Events">Events</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="About_Us">About Us</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="community" asp-controller="Account">Community</a>
                </li>
                <li class="nav-item ml-lg-3">
                    <a class="btn btn-outline-primary" href="/Account/Register">Register</a>
                </li>
                <li class="nav-item ml-lg-2">
                    <a class="btn btn-primary" href="/Account/Login">Login</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- Terms & Conditions Content -->
<section class="py-5">
    <div class="container">
        <h1 class="text-secondary text-center mb-4">Terms and Conditions</h1>
        <div class="card shadow-sm mb-5">
            <div class="card-body">
                <section>
                    <h2 class="text-secondary">Welcome to the College Selection System!</h2>
                    <p>
                        Thank you for choosing the College Selection System as your guide to selecting the best college for your academic journey. By accessing or using our platform, you agree to be bound by these Terms and Conditions. Please read them carefully before proceeding.
                    </p>
                </section>

                <section class="mt-4">
                    <h3 class="text-secondary">1. Acceptance of Terms</h3>
                    <p>
                        By using the College Selection System, you affirm that you are at least 16 years of age or have received permission from a parent or legal guardian to use this website. Your continued use constitutes acceptance of these Terms and any modifications made.
                    </p>
                </section>

                <section class="mt-4">
                    <h3 class="text-secondary">2. Purpose of the Platform</h3>
                    <p>
                        The College Selection System is designed to provide guidance and resources to help students select colleges that best meet their preferences, needs, and goals. The information provided is intended for informational purposes only and should not be considered as professional advice or the sole determinant in making a college decision.
                    </p>
                </section>

                <section class="mt-4">
                    <h3 class="text-secondary">3. User Responsibilities</h3>
                    <ul class="pl-3">
                        <li>Provide accurate and up-to-date information during the use of the platform.</li>
                        <li>Independently verify the accuracy of college information before making final decisions.</li>
                        <li>Refrain from using the platform for unlawful purposes or data misrepresentation.</li>
                    </ul>
                </section>

                <section class="mt-4">
                    <h3 class="text-secondary">4. Disclaimer of Liability</h3>
                    <ul class="pl-3">
                        <li>We do not guarantee the accuracy, completeness, or timeliness of any information provided.</li>
                        <li>The platform is not liable for any outcomes resulting from its use.</li>
                        <li>Consult additional resources or advisors for comprehensive decision-making.</li>
                    </ul>
                </section>

                <section class="mt-4">
                    <h3 class="text-secondary">5. Third-Party Links and Resources</h3>
                    <p>
                        This website may include links to third-party resources. Inclusion does not imply endorsement, and we are not responsible for external content or practices.
                    </p>
                </section>

                <section class="mt-4">
                    <h3 class="text-secondary">6. Intellectual Property</h3>
                    <p>
                        All content—text, images, software, and designs—is owned by the College Selection System unless otherwise noted. Unauthorized use, reproduction, or distribution is prohibited.
                    </p>
                </section>

                <section class="mt-4">
                    <h3 class="text-secondary">7. Privacy and Data Security</h3>
                    <p>
                        We respect your privacy and protect your data. See our
                        <a asp-action="Privacy_Policy" class="font-weight-bold">Privacy Policy</a> for details.
                    </p>
                </section>

                <section class="mt-4">
                    <h3 class="text-secondary">8. Modifications to the Terms</h3>
                    <p>
                        We reserve the right to update these Terms at any time without prior notice. Please review them regularly.
                    </p>
                </section>

                <section class="mt-4">
                    <h3 class="text-secondary">9. Governing Law</h3>
                    <p>
                        These Terms are governed by the laws of Pennsylvania, USA. Disputes are subject to the exclusive jurisdiction of Pennsylvania courts.
                    </p>
                </section>

                <hr class="my-4" />

                <section>
                    <h5>Contact Us</h5>
                    <p>
                        For inquiries or feedback, email
                        <a href="mailto:decideconfidently@froootpizza.com" class="font-weight-bold">decideconfidently@froootpizza.com</a>.
                    </p>
                    <p class="text-muted small mb-0">
                        <strong>Last Updated:</strong> May 12, 2024
                    </p>
                </section>
            </div>
        </div>
    </div>
</section>

<!-- Footer -->
<footer>
    <div class="container">
        <div class="row">
            <div class="col-lg-4 mb-4 mb-lg-0">
                <h5>Decide Confidently™</h5>
                <p>Helping students make the best college decisions since 2015.</p>
            </div>
            <div class="col-lg-2 col-md-6 mb-4 mb-md-0">
                <h5>Quick Links</h5>
                <ul class="list-unstyled">
                    <li><a class="text-white" asp-controller="College" asp-action="Index">College Selection Tool</a></li>
                    <li><a class="text-white" asp-action="About_Us">About Us</a></li>
                    <li><a class="text-white" asp-action="Terms_Conditions">Terms & Condition</a></li>
                    <li><a class="text-white" asp-action="Privacy_Policy">Privacy Policy</a></li>
                </ul>
            </div>
            <div class="col-lg-3 col-md-6 mb-4 mb-md-0">
                <h5>Connect</h5>
                <ul class="list-unstyled">
                    <li><a class="text-white" href="https://www.facebook.com/profile.php?id=100066758075620"><i class="fab fa-facebook-f mr-2"></i>Facebook</a></li>
                    <li><a class="text-white" href="https://instagram.com/froootpizza/"><i class="fab fa-instagram mr-2"></i>Instagram</a></li>
                </ul>
            </div>
            <div class="col-lg-3">
                <h5>Contact Us</h5>
                <ul class="list-unstyled">
                    <li><i class="fas fa-envelope mr-2"></i>decideconfidently@froootpizza.com</li>
                </ul>
            </div>
        </div>
        <hr class="bg-white my-4" />
        <div class="text-center">
            <p class="mb-0">&copy; @DateTime.Now.Year Decide Confidently™. All rights reserved.</p>
        </div>
    </div>
</footer>

<!-- Bootstrap JS & dependencies -->
<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
