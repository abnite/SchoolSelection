@model PasswordRecoveryViewModel
@{
    ViewBag.Title = "Password Recovery";
    Layout = "_LoginLayout";
}

<section class="py-5">
    <div class="container">
        <div class="register-container">
            <div class="register-card">
                <div class="text-center mb-4">
                    <img src="~/images/schoolselection.jpeg" alt="Logo" height="80" class="mb-3">
                    <h3>Forget Password</h3>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <form asp-action="passwordRecovery" role="form" method="post" enctype="multipart/form-data" asp-controller="Account" eval="CloseForm(data,$ajaxTarget,XHR)">
                    <div class="form-group">
                        <label class="control-label" for="username">Email</label>
                        <input asp-for="Email" type="text" placeholder="example@gmail.com" title="Please enter you email address" required="required" class="form-control">
                        <span asp-validation-for="Email" class="text-red"></span>
                    </div>

                    <div style="display: flex; justify-content: space-between; margin-top: 10px;">
                        <button type="submit" class="btn btn-success login btn">Send Recovery Email</button>
                        <a title="Click To Register" style="color: #0b5ed7" asp-controller="Account" asp-action="Login">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
