@{
    ViewBag.Title = "My Selections";
    Layout = "_BackendLayout";
}

<section class="content" style="padding:1.5rem">

  <!-- Page title -->
  <div style="margin-bottom:1.5rem">
    <h2 style="font-size:1.6rem;font-weight:800;letter-spacing:-.03em;color:var(--text);margin:0">
      <i class="fas fa-list-ul mr-2" style="color:var(--primary)"></i>My College Selections
    </h2>
    <p style="color:var(--text-muted);font-size:.875rem;margin:.25rem 0 0">
      All your college selection journeys — view, continue, or review results.
    </p>
  </div>

  <!-- ── Actions bar ───────────────────────────────────────── -->
  <div style="margin-bottom:1.25rem">
    <a asp-action="CollegeSelectionName" asp-controller="College" class="btn btn-primary">
      <i class="fas fa-plus mr-2"></i> Start New Journey
    </a>
  </div>

  <!-- ── Table card ────────────────────────────────────────── -->
  <div class="card">
    <div class="card-header bg-primary text-white d-flex align-items-center justify-content-between">
      <h5 style="margin:0;font-weight:700;font-size:.95rem">
        <i class="fas fa-table mr-2" style="opacity:.8"></i> Selection History
      </h5>
    </div>
    <div class="card-body" style="padding:1.25rem!important;overflow-x:auto">
      <table id="collegeTable" class="display table table-bordered table-striped" style="width:100%">
        <thead>
          <tr>
            <th>#</th>
            <th>Journey Name</th>
            <th>Date</th>
            <th>User</th>
            <th>Email</th>
            <th>Country</th>
            <th>Status</th>
            <th style="text-align:center">Actions</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </div>

</section>

<!-- ── Evaluation detail modal ──────────────────────────────── -->
<div class="modal fade" id="evaluationModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title font-weight-bold">
          <span style="font-size:1.1rem;margin-right:.4rem">✦</span> Evaluation Results
        </h5>
        <button type="button" class="close text-white" data-dismiss="modal">
          <span>&times;</span>
        </button>
      </div>
      <div class="modal-body" style="min-height:120px;padding:1.5rem!important">
        <div id="evaluationContent">
          <div style="text-align:center;padding:2rem;color:var(--text-light)">
            <div class="spinner-ring" style="margin:0 auto 1rem"></div>
            Loading…
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
  <script>
    $(document).ready(function () {
      $('#collegeTable').DataTable({
        processing: true,
        serverSide: true,
        ajax: {
          url: '/College/GetPaginatedCollegeSelections',
          type: 'GET',
          data: function (d) { d.searchValue = d.search.value; }
        },
        language: {
          processing: '<div style="padding:.5rem"><i class="fas fa-spinner fa-spin mr-2" style="color:var(--primary)"></i>Loading…</div>'
        },
        columns: [
          {
            data: null,
            render: (data, type, row, meta) => meta.row + 1,
            width: '40px'
          },
          { data: 'collegeSelectionName', render: data => `<strong>${data}</strong>` },
          { data: 'dateAdded' },
          { data: 'addedBy' },
          { data: 'email' },
          { data: 'country' },
          {
            data: 'status',
            render: data => {
              const cls  = data === 'Completed' ? 'badge-success' : 'badge-warning';
              const icon = data === 'Completed' ? 'fa-check' : 'fa-clock';
              return `<span class="badge ${cls}"><i class="fas ${icon} mr-1"></i>${data}</span>`;
            }
          },
          {
            data: 'id',
            orderable: false,
            render: (data, type, row) => {
              if (row.status === 'Completed') {
                return `
                  <div style="display:flex;gap:.35rem;justify-content:center">
                    <button class="btn btn-info btn-sm view-evaluation"
                            title="View College Fit"
                            data-toggle="modal" data-target="#evaluationModal"
                            data-id="${data}">
                      <i class="fas fa-eye"></i>
                    </button>
                    <a href="/College/ResumeEvaluation?collegeSelectionId=${data}"
                       class="btn btn-primary btn-sm" title="Refine College Fit">
                      <i class="fas fa-pen"></i>
                    </a>
                    <a href="/College/ViewHistorySelection?collegeSelectionId=${data}"
                       class="btn btn-secondary btn-sm" title="View History">
                      <i class="fas fa-history"></i>
                    </a>
                  </div>`;
              } else {
                return `
                  <div style="display:flex;gap:.35rem;justify-content:center">
                    <a href="/College/ResumeEvaluation?collegeSelectionId=${data}"
                       class="btn btn-primary btn-sm" title="Continue Process">
                      <i class="fas fa-play mr-1"></i> Continue
                    </a>
                  </div>`;
              }
            }
          }
        ]
      });

      // Load evaluation details via AJAX
      $(document).on('click', '.view-evaluation', function () {
        const id = $(this).data('id');
        $('#evaluationContent').html(`
          <div style="text-align:center;padding:2rem;color:var(--text-light)">
            <div class="spinner-ring" style="margin:0 auto 1rem"></div>
            Loading…
          </div>`);

        $.ajax({
          url: '/College/GetEvaluationDetails',
          type: 'GET',
          data: { id },
          success: data => $('#evaluationContent').html(data),
          error: xhr => {
            if (xhr.status === 401) {
              alert('Session expired. Please log in again.');
              window.location.href = '/Account/Login';
            } else if (xhr.status === 404) {
              $('#evaluationContent').html('<p style="text-align:center;color:var(--text-muted)">Evaluation not found.</p>');
            } else {
              $('#evaluationContent').html('<p style="text-align:center;color:var(--danger-c)">Error loading details.</p>');
            }
          }
        });
      });
    });
  </script>
}
