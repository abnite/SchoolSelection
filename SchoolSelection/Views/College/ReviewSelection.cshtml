@model CollegeSelection
@{
    ViewBag.Title = "Review Selection";
    Layout = "_BackendLayout";
    Guid CollegeSelectionId = ViewBag.CollegeSelectionId;
}

<section class="content">
  <div class="wizard-wrapper">

    <!-- ── Wizard steps ──────────────────────────────────── -->
    <div class="wizard-steps">
      <div class="wizard-step completed">
        <div class="wizard-step-circle"><i class="fas fa-check" style="font-size:.7rem"></i></div>
        <div class="wizard-step-label">Name</div>
      </div>
      <div class="wizard-step completed">
        <div class="wizard-step-circle"><i class="fas fa-check" style="font-size:.7rem"></i></div>
        <div class="wizard-step-label">Schools</div>
      </div>
      <div class="wizard-step completed">
        <div class="wizard-step-circle"><i class="fas fa-check" style="font-size:.7rem"></i></div>
        <div class="wizard-step-label">Criteria</div>
      </div>
      <div class="wizard-step active">
        <div class="wizard-step-circle">4</div>
        <div class="wizard-step-label">Review</div>
      </div>
      <div class="wizard-step">
        <div class="wizard-step-circle">5</div>
        <div class="wizard-step-label">AI Result</div>
      </div>
      <div class="wizard-step">
        <div class="wizard-step-circle"><i class="fas fa-flag" style="font-size:.7rem"></i></div>
        <div class="wizard-step-label">Summary</div>
      </div>
    </div>

    <!-- ── Page heading ──────────────────────────────────── -->
    <div class="page-heading">
      <h1>Review Your Selection</h1>
      <p class="lead">Step 4 of 6 &mdash; Confirm your colleges and criteria before generating your AI recommendation.</p>
      @if (!string.IsNullOrEmpty(ViewBag.CollegeSelectionName?.ToString()))
      {
        <p class="journey-name"><i class="fas fa-route mr-1"></i> @ViewBag.CollegeSelectionName</p>
      }
      <hr>
    </div>

    <!-- ── Two-column review cards ─────────────────────── -->
    <div style="max-width:860px;margin:1.5rem auto 0">
      <div class="row">

        <!-- Colleges -->
        <div class="col-lg-6 mb-4">
          <div class="card h-100 animate-in">
            <div class="card-header bg-primary text-white d-flex align-items-center justify-content-between">
              <h5 style="margin:0;font-weight:700;font-size:.95rem">
                <i class="fas fa-university mr-2" style="opacity:.8"></i> Selected Colleges
              </h5>
              <span style="background:rgba(255,255,255,.2);border-radius:20px;padding:.15rem .75rem;font-size:.78rem;font-weight:700">
                @ViewBag.Colleges.Count
              </span>
            </div>
            <div class="card-body" style="padding:1rem!important">
              @if (ViewBag.Colleges.Count == 0)
              {
                <div style="text-align:center;padding:2rem;color:var(--text-light)">
                  <i class="fas fa-university" style="font-size:2rem;opacity:.2;display:block;margin-bottom:.5rem"></i>
                  No colleges added yet.
                </div>
              }
              else
              {
                <ul class="list-group list-group-flush" style="padding:0">
                  @foreach (var college in ViewBag.Colleges)
                  {
                    <li class="list-group-item" style="padding:.625rem 1rem!important">
                      <i class="fas fa-dot-circle mr-2" style="color:var(--primary);font-size:.65rem"></i>
                      <strong>@college.Name</strong>
                    </li>
                  }
                </ul>
              }
            </div>
          </div>
        </div>

        <!-- Criteria -->
        <div class="col-lg-6 mb-4">
          <div class="card h-100 animate-in">
            <div class="card-header bg-success text-white d-flex align-items-center justify-content-between">
              <h5 style="margin:0;font-weight:700;font-size:.95rem">
                <i class="fas fa-sliders-h mr-2" style="opacity:.8"></i> Selected Criteria
              </h5>
              <span style="background:rgba(255,255,255,.2);border-radius:20px;padding:.15rem .75rem;font-size:.78rem;font-weight:700">
                @ViewBag.Criteria.Count
              </span>
            </div>
            <div class="card-body" style="padding:1rem!important">
              @if (ViewBag.Criteria.Count == 0)
              {
                <div style="text-align:center;padding:2rem;color:var(--text-light)">
                  <i class="fas fa-sliders-h" style="font-size:2rem;opacity:.2;display:block;margin-bottom:.5rem"></i>
                  No criteria added yet.
                </div>
              }
              else
              {
                <ul class="list-group list-group-flush" style="padding:0">
                  @foreach (var criteria in ViewBag.Criteria)
                  {
                    var dotColor = criteria.Importance switch {
                      "Extremely" => "#ef233c",
                      "Very"      => "#ff9f1c",
                      "Neutral"   => "#4cc9f0",
                      "Slightly"  => "#06d6a0",
                      _           => "#9ca3af"
                    };
                    var badgeCls = criteria.Importance switch {
                      "Extremely" => "badge-danger",
                      "Very"      => "badge-warning",
                      "Neutral"   => "badge-info",
                      "Slightly"  => "badge-success",
                      _           => "badge-secondary"
                    };
                    <li class="list-group-item d-flex justify-content-between align-items-center"
                        style="padding:.625rem 1rem!important">
                      <span>
                        <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:@dotColor;margin-right:.4rem"></span>
                        <strong>@criteria.Name</strong>
                      </span>
                      <span class="badge @badgeCls">@criteria.Importance</span>
                    </li>
                  }
                </ul>
              }
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- ── Action buttons ─────────────────────────────── -->
    <div style="max-width:860px;margin:0 auto 2rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem">
      <a id="CriteriaSelectionBtn"
         asp-action="CriteriaSelection"
         asp-route-CollegeSelectionId="@CollegeSelectionId"
         class="btn btn-secondary">
        <i class="fas fa-arrow-left mr-2"></i> Back to Criteria
      </a>

      <form asp-action="GenerateRecommendation"
            asp-route-collegeSelectionId="@CollegeSelectionId"
            id="generateForm">
        <button type="submit" id="generateRecBtn" class="btn btn-primary btn-lg">
          <i class="fas fa-robot mr-2"></i> Generate AI Recommendation
        </button>
      </form>
    </div>

  </div>
</section>

@section Scripts {
  <script>
    document.getElementById('generateForm').addEventListener('submit', function () {
      var btn  = document.getElementById('generateRecBtn');
      var back = document.getElementById('CriteriaSelectionBtn');
      btn.disabled  = true;
      back.classList.add('disabled');
      btn.innerHTML = '<span class="spinner-border spinner-border-sm mr-2" role="status" aria-hidden="true"></span>Generating…';
    });
  </script>
}
