@model School

@{
    ViewBag.Title = "School Selection";
    Layout = "_BackendLayout";
}
@{
    var remainingColleges = ViewData["RemainingColleges"] as int? ?? 0;
    remainingColleges = remainingColleges < 0 ? 0 : remainingColleges;
    var planType = ViewData["PlanType"] as string;
    string CollegeSelectionId = ViewData["CollegeSelectionId"] as string;
    var CollegeSelectionName = "";

    var getSchools = await _Context.Schools.ToListAsync();
    if (!string.IsNullOrEmpty(CollegeSelectionId))
    {
        var getCollegeSelection = await _Context.CollegeSelections
            .Where(i => i.Id == Guid.Parse(CollegeSelectionId))
            .FirstOrDefaultAsync();
        getSchools = await _Context.Schools
            .Where(i => i.CollegeSelectionId == Guid.Parse(CollegeSelectionId))
            .ToListAsync();
        CollegeSelectionName = getCollegeSelection.CollegeSelectionName;
    }
}

<section class="content">
  <div class="wizard-wrapper">

    <!-- ── Wizard step indicator ─────────────────────────── -->
    <div class="wizard-steps">
      <div class="wizard-step completed">
        <div class="wizard-step-circle"><i class="fas fa-check" style="font-size:.7rem"></i></div>
        <div class="wizard-step-label">Name</div>
      </div>
      <div class="wizard-step active">
        <div class="wizard-step-circle">2</div>
        <div class="wizard-step-label">Schools</div>
      </div>
      <div class="wizard-step">
        <div class="wizard-step-circle">3</div>
        <div class="wizard-step-label">Criteria</div>
      </div>
      <div class="wizard-step">
        <div class="wizard-step-circle">4</div>
        <div class="wizard-step-label">Evaluate</div>
      </div>
      <div class="wizard-step">
        <div class="wizard-step-circle">5</div>
        <div class="wizard-step-label">AI Result</div>
      </div>
      <div class="wizard-step">
        <div class="wizard-step-circle"><i class="fas fa-flag" style="font-size:.7rem"></i></div>
        <div class="wizard-step-label">Summary</div>
      </div>
    </div>

    <!-- ── Page heading ──────────────────────────────────── -->
    <div class="page-heading">
      <h1>Add Schools to Evaluate</h1>
      <p class="lead">Step 2 of 6 &mdash; Add up to <strong>@remainingColleges</strong> school@(remainingColleges == 1 ? "" : "s") to assess.</p>
      @if (!string.IsNullOrEmpty(CollegeSelectionName))
      {
        <p class="journey-name"><i class="fas fa-route mr-1"></i> @CollegeSelectionName</p>
      }
      <hr>
    </div>

    <!-- ── Plan banner ───────────────────────────────────── -->
    <div style="max-width:680px;margin:1.25rem auto 0">
      <div class="plan-banner">
        <div>
          <div class="plan-name"><i class="fas fa-tag mr-1" style="opacity:.8"></i> Plan: @planType</div>
          <div class="plan-remaining">
            @if (remainingColleges == 0)
            {
              <span style="color:#fde68a;font-weight:600">
                ⚠ School limit reached &mdash;
                <a href="@Url.Action("SubscriptionOptions", "SubscriptionPlan")" style="color:#fde68a;text-decoration:underline">upgrade</a>
              </span>
            }
            else
            {
              <span>@remainingColleges school slot@(remainingColleges == 1 ? "" : "s") remaining</span>
            }
          </div>
        </div>
        <button class="btn btn-outline-light btn-sm" type="button"
                data-toggle="collapse" data-target="#planDetails"
                aria-expanded="false">
          <i class="fas fa-info-circle mr-1"></i> Details
        </button>
      </div>
      <div class="collapse collapse-section" id="planDetails">
        <div style="padding:1rem 1.25rem">
          <p style="margin:0;font-size:.875rem;color:var(--text-muted)">
            Each school you add counts toward your plan limit. You can delete schools to free up slots.
            Make sure to choose schools you genuinely want to evaluate.
          </p>
        </div>
      </div>
    </div>

    <!-- ── Add / Update form ─────────────────────────────── -->
    <div style="max-width:680px;margin:1.25rem auto 0">
      <div class="card animate-in">
        <div class="card-header bg-primary text-white">
          <h5 style="margin:0;font-weight:700;font-size:.95rem">
            <i class="fas fa-plus-circle mr-2" style="opacity:.8"></i>
            @(Model?.Id == null ? "Add a School" : "Update School")
          </h5>
        </div>
        <div class="card-body">
          <form asp-action="AddOrUpdateSchool" method="post">
            <input type="hidden" name="Id" value="@Model?.Id" />
            <input type="hidden" asp-for="CollegeSelectionId" value="@CollegeSelectionId" />

            <div class="form-group mb-3">
              <label for="schoolName"><i class="fas fa-university mr-1" style="color:var(--primary)"></i> School Name</label>
              <input type="text" class="form-control form-control-lg"
                     asp-for="Name" id="schoolName"
                     placeholder="e.g., MIT, Stanford, Harvard" required>
            </div>

            <div class="form-group mb-4">
              <label for="schoolInfo"><i class="fas fa-sticky-note mr-1" style="color:var(--primary)"></i> Additional Notes</label>
              <textarea class="form-control" asp-for="Info" id="schoolInfo" rows="3"
                        placeholder="Location, programs of interest, any notes…"></textarea>
            </div>

            <div class="d-flex justify-content-between align-items-center">
              <button type="submit"
                      class="btn btn-success"
                      @(remainingColleges == 0 ? "disabled" : "")>
                <i class="fas fa-@(Model?.Id == null ? "plus" : "save") mr-1"></i>
                @(Model?.Id == null ? "Add School" : "Update School")
              </button>

              @if (getSchools.Count == 0)
              {
                <span class="btn btn-primary disabled" style="opacity:.5;cursor:not-allowed">
                  Next Step <i class="fas fa-arrow-right ml-1"></i>
                </span>
              }
              else
              {
                <a asp-action="CriteriaSelection" class="btn btn-primary">
                  Next Step <i class="fas fa-arrow-right ml-1"></i>
                </a>
              }
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- ── Added schools list ─────────────────────────────── -->
    <div style="max-width:680px;margin:1.25rem auto 2rem">
      <div class="card animate-in">
        <div class="card-header bg-success text-white d-flex align-items-center justify-content-between">
          <h5 style="margin:0;font-weight:700;font-size:.95rem">
            <i class="fas fa-list-ul mr-2" style="opacity:.8"></i> Added Schools
          </h5>
          <span style="background:rgba(255,255,255,.2);border-radius:20px;padding:.2rem .75rem;font-size:.8rem;font-weight:700">
            @getSchools.Count
          </span>
        </div>
        <div class="card-body" style="padding:1rem!important">
          @if (getSchools.Count == 0)
          {
            <div style="text-align:center;padding:2rem;color:var(--text-light)">
              <i class="fas fa-school" style="font-size:2.5rem;opacity:.25;display:block;margin-bottom:.75rem"></i>
              No schools added yet. Add your first school above.
            </div>
          }
          else
          {
            <ul class="list-group list-group-flush" style="padding:0">
              @foreach (var school in getSchools)
              {
                <li class="list-group-item d-flex justify-content-between align-items-start">
                  <div>
                    <div style="font-weight:700;color:var(--text)">@school.Name</div>
                    @if (!string.IsNullOrEmpty(school.Info))
                    {
                      <small style="color:var(--text-muted)">@school.Info</small>
                    }
                  </div>
                  <div style="display:flex;gap:.4rem;flex-shrink:0;margin-left:1rem">
                    <a asp-action="EditSchool" asp-route-id="@school.Id" class="btn btn-primary btn-sm">
                      <i class="fas fa-pen"></i>
                    </a>
                    <a asp-action="DeleteSchool" asp-route-id="@school.Id" class="btn btn-danger btn-sm">
                      <i class="fas fa-trash"></i>
                    </a>
                  </div>
                </li>
              }
            </ul>
          }
        </div>
      </div>
    </div>

  </div>
</section>
