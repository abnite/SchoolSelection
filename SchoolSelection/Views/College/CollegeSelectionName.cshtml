@model SchoolSelection.Models.CollegeSelection

@{
    ViewBag.Title = "Create Selection";
    Layout = "_BackendLayout";

    var dateYear = DateTime.Today.Year;
    var remainingSelections = ViewData["RemainingSelections"] as int? ?? 0;
    remainingSelections = remainingSelections < 0 ? 0 : remainingSelections;
    var planType = ViewData["PlanType"] as string;
}

<section class="content">
  <div class="wizard-wrapper">

    <!-- ── Wizard step indicator ─────────────────────────── -->
    <div class="wizard-steps">
      <div class="wizard-step active">
        <div class="wizard-step-circle">1</div>
        <div class="wizard-step-label">Name</div>
      </div>
      <div class="wizard-step">
        <div class="wizard-step-circle">2</div>
        <div class="wizard-step-label">Schools</div>
      </div>
      <div class="wizard-step">
        <div class="wizard-step-circle">3</div>
        <div class="wizard-step-label">Criteria</div>
      </div>
      <div class="wizard-step">
        <div class="wizard-step-circle">4</div>
        <div class="wizard-step-label">Evaluate</div>
      </div>
      <div class="wizard-step">
        <div class="wizard-step-circle">5</div>
        <div class="wizard-step-label">AI Result</div>
      </div>
      <div class="wizard-step">
        <div class="wizard-step-circle"><i class="fas fa-flag" style="font-size:.7rem"></i></div>
        <div class="wizard-step-label">Summary</div>
      </div>
    </div>

    <!-- ── Page heading ──────────────────────────────────── -->
    <div class="page-heading">
      <h1>Start Your College Journey</h1>
      <p class="lead">Give your selection a memorable name to get started.</p>
      <hr>
    </div>

    <!-- ── Plan banner ───────────────────────────────────── -->
    <div style="max-width:640px;margin:1.5rem auto 0">
      <div class="plan-banner animate-in">
        <div>
          <div class="plan-name">
            <i class="fas fa-tag mr-1" style="opacity:.8"></i> Plan: @planType
          </div>
          <div class="plan-remaining">
            @if (remainingSelections == 0)
            {
              <span style="color:#fde68a;font-weight:600">
                ⚠ Limit reached &mdash;
                <a href="@Url.Action("SubscriptionOptions", "SubscriptionPlan")" style="color:#fde68a;text-decoration:underline">upgrade to continue</a>
              </span>
            }
            else
            {
              <span>@remainingSelections selection@(remainingSelections == 1 ? "" : "s") remaining</span>
            }
          </div>
        </div>
        <div style="font-size:2.5rem;opacity:.18">
          <i class="fas fa-graduation-cap"></i>
        </div>
      </div>
    </div>

    <!-- ── Name entry form ───────────────────────────────── -->
    <div style="max-width:640px;margin:1.25rem auto 2rem">
      <div class="card animate-in">
        <div class="card-body">
          <form asp-controller="College" asp-action="CollegeSelection" method="post" id="selectionForm">

            <div class="form-group mb-4">
              <label for="CollegeSelectionName">
                <i class="fas fa-pencil-alt mr-1" style="color:var(--primary)"></i> Journey Name
              </label>
              <input type="text"
                     asp-for="CollegeSelectionName"
                     class="form-control form-control-lg"
                     placeholder="e.g., My @dateYear College Journey"
                     required />
              <small style="color:var(--text-muted);font-size:.78rem;margin-top:.3rem;display:block">
                Choose a name that helps you remember this search later.
              </small>
            </div>

            <div class="d-flex align-items-center justify-content-between">
              <div style="font-size:.8rem;color:var(--text-muted)">
                <i class="fas fa-info-circle mr-1" style="color:var(--warning-c)"></i>
                Once created, this uses one of your plan slots.
              </div>
              <button type="button"
                      class="btn btn-primary btn-lg"
                      onclick="confirmSubmission(event)"
                      @(remainingSelections == 0 ? "disabled" : "")>
                Save &amp; Continue <i class="fas fa-arrow-right ml-2"></i>
              </button>
            </div>

          </form>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- ── Confirmation Modal ─────────────────────────────────── -->
<div class="modal fade" id="confirmationModal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header bg-warning">
        <h5 class="modal-title font-weight-bold text-dark">
          <i class="fas fa-exclamation-triangle mr-2"></i> Confirm Action
        </h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body" style="padding:1.5rem">
        @if (planType == "Free")
        {
          <p><strong>Your plan is Free</strong> — you are allowed <strong>1 college selection entry</strong>.</p>
        }
        else
        {
          <p>You have <strong>@remainingSelections</strong> selection@(remainingSelections == 1 ? "" : "s") remaining on your current plan.</p>
        }
        <p class="mb-0">Once you proceed, <strong>this slot cannot be recovered</strong>. Are you ready?</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-success" id="confirmSubmit">
          <i class="fas fa-check mr-1"></i> Yes, Let's Go
        </button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
  <script>
    function confirmSubmission(e) {
      e.preventDefault();
      $('#confirmationModal').modal('show');
    }

    $(document).ready(function () {
      $('#confirmSubmit').click(function () {
        $(this).prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Creating...');
        $('#selectionForm').submit();
      });
    });
  </script>
}
