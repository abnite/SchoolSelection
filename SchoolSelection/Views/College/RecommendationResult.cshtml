@using Microsoft.AspNetCore.Mvc.TagHelpers
@model SchoolSelection.ViewModels.ResultsViewModel

@{
    ViewBag.Title = "AI Recommendation";
    Layout = "_BackendLayout";
    var recommendation = TempData["Recommendation"] as string;
}

<section class="content">
  <div class="wizard-wrapper">

    <!-- ── Wizard steps ──────────────────────────────────── -->
    <div class="wizard-steps">
      <div class="wizard-step completed">
        <div class="wizard-step-circle"><i class="fas fa-check" style="font-size:.7rem"></i></div>
        <div class="wizard-step-label">Name</div>
      </div>
      <div class="wizard-step completed">
        <div class="wizard-step-circle"><i class="fas fa-check" style="font-size:.7rem"></i></div>
        <div class="wizard-step-label">Schools</div>
      </div>
      <div class="wizard-step completed">
        <div class="wizard-step-circle"><i class="fas fa-check" style="font-size:.7rem"></i></div>
        <div class="wizard-step-label">Criteria</div>
      </div>
      <div class="wizard-step completed">
        <div class="wizard-step-circle"><i class="fas fa-check" style="font-size:.7rem"></i></div>
        <div class="wizard-step-label">Evaluate</div>
      </div>
      <div class="wizard-step active">
        <div class="wizard-step-circle">5</div>
        <div class="wizard-step-label">AI Result</div>
      </div>
      <div class="wizard-step">
        <div class="wizard-step-circle"><i class="fas fa-flag" style="font-size:.7rem"></i></div>
        <div class="wizard-step-label">Summary</div>
      </div>
    </div>

    <!-- ── Heading ───────────────────────────────────────── -->
    <div class="page-heading">
      <h1>Your AI Recommendation</h1>
      <p class="lead">Step 5 of 6 &mdash; Review your personalized college fit analysis.</p>
      <hr>
    </div>

    <!-- ── AI recommendation card ────────────────────────── -->
    <div style="max-width:720px;margin:1.5rem auto 0">
      <div class="card animate-in">
        <div class="card-header bg-info text-white">
          <h5 style="margin:0;font-weight:700;font-size:.95rem;display:flex;align-items:center;gap:.5rem">
            <span style="font-size:1.2rem">✦</span> Preliminary College Fit Report
          </h5>
        </div>
        <div class="card-body">
          <div class="ai-box">
            @Html.Raw(recommendation)
          </div>

          <div class="mt-4 p-3" style="background:var(--primary-light);border-radius:var(--r);border:1px solid rgba(67,97,238,.15)">
            <p style="margin:0 0 .375rem;font-weight:700;font-size:.875rem;color:var(--primary)">
              <i class="fas fa-question-circle mr-1"></i> What would you like to do next?
            </p>
            <p style="margin:0;font-size:.8rem;color:var(--text-muted)">
              You can finish now and save this recommendation, or go back and refine your evaluations for a more detailed result.
            </p>
          </div>

          <div class="d-flex justify-content-center mt-4" style="gap:1rem;flex-wrap:wrap">
            <form method="post" asp-action="SaveRecommendationResults">
              <input type="hidden" asp-for="CollegeSelectionId" />
              <input type="hidden" asp-for="Result" value="@recommendation" />
              <button type="submit" class="btn btn-success btn-lg">
                <i class="fas fa-flag-checkered mr-2"></i> Save &amp; Finish
              </button>
            </form>
            <a asp-action="CollegeEvaluation"
               asp-route-collegeSelectionId="@Model.CollegeSelectionId"
               class="btn btn-primary btn-lg">
              <i class="fas fa-edit mr-2"></i> Refine Evaluations
            </a>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
