@model SchoolSelection.Models.CollegeSelection

@{
    ViewBag.Title = "Home";
    Layout = "_BackendLayout";

    var dateYear = DateTime.Today.Year;
    var remainingSelections = ViewData["RemainingSelections"] as int? ?? 0;
    remainingSelections = remainingSelections < 0 ? 0 : remainingSelections;
    var planType = ViewData["PlanType"] as string;
}

<section class="content" style="padding:1.5rem">

  <!-- ── Hero banner ───────────────────────────────────────── -->
  <div style="background:linear-gradient(135deg,#4361ee 0%,#7b2ff7 60%,#06d6a0 100%);border-radius:var(--r-xl);padding:2.5rem 2rem;color:#fff;position:relative;overflow:hidden;margin-bottom:1.75rem" class="animate-in">
    <!-- Decorative circles -->
    <div style="position:absolute;right:-40px;top:-40px;width:200px;height:200px;border-radius:50%;background:rgba(255,255,255,.07)"></div>
    <div style="position:absolute;right:80px;bottom:-60px;width:140px;height:140px;border-radius:50%;background:rgba(255,255,255,.05)"></div>
    <div class="row align-items-center">
      <div class="col-md-8">
        <p style="font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;opacity:.75;margin:0 0 .5rem">
          Welcome back
        </p>
        <h1 style="font-size:2rem;font-weight:800;margin:0 0 .75rem;letter-spacing:-.03em;line-height:1.2">
          Your College Selection<br>Journey Starts Here
        </h1>
        <p style="font-size:.9rem;opacity:.85;max-width:480px;line-height:1.65;margin:0 0 1.5rem">
          A smarter way to find your best college fit. Add schools, define criteria, get AI-powered recommendations — all in one place.
        </p>
        <div style="display:flex;gap:.75rem;flex-wrap:wrap">
          <a href="@Url.Action("CollegeSelectionName", "College")"
             class="btn btn-lg"
             style="background:#fff;color:var(--primary);font-weight:700;border-radius:var(--r-sm);padding:.625rem 1.5rem;box-shadow:0 6px 24px rgba(0,0,0,.2)"
             @(remainingSelections == 0 ? "aria-disabled=true style='pointer-events:none;opacity:.5'" : "")>
            <i class="fas fa-plus mr-2"></i> Start New Journey
          </a>
          <a href="@Url.Action("ViewSelection", "College")"
             style="background:rgba(255,255,255,.15);color:#fff;font-weight:600;border-radius:var(--r-sm);padding:.625rem 1.5rem;border:1.5px solid rgba(255,255,255,.35);font-size:.9rem;display:inline-flex;align-items:center;gap:.4rem">
            <i class="fas fa-list-ul"></i> View All
          </a>
        </div>
      </div>
      <div class="col-md-4 d-none d-md-flex justify-content-end align-items-center" style="font-size:7rem;opacity:.12">
        <i class="fas fa-graduation-cap"></i>
      </div>
    </div>
  </div>

  <!-- ── Quick plan status ──────────────────────────────────── -->
  <div class="row mb-4">
    <div class="col-md-4 mb-3 animate-in">
      <div class="stat-card blue" style="padding:1.25rem">
        <div class="stat-icon" style="width:50px;height:50px;font-size:1.3rem">
          <i class="fas fa-tag"></i>
        </div>
        <div>
          <div style="font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;opacity:.8">Current Plan</div>
          <div style="font-size:1.3rem;font-weight:800;line-height:1.1;margin-top:.15rem">@planType</div>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-3 animate-in">
      <div class="stat-card @(remainingSelections == 0 ? "orange" : "green")" style="padding:1.25rem">
        <div class="stat-icon" style="width:50px;height:50px;font-size:1.3rem">
          <i class="fas fa-@(remainingSelections == 0 ? "exclamation-triangle" : "check-circle")"></i>
        </div>
        <div>
          <div style="font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;opacity:.8">Selections Left</div>
          <div style="font-size:1.3rem;font-weight:800;line-height:1.1;margin-top:.15rem">@remainingSelections</div>
        </div>
      </div>
    </div>
    <div class="col-md-4 mb-3 animate-in">
      <div class="stat-card teal" style="padding:1.25rem">
        <div class="stat-icon" style="width:50px;height:50px;font-size:1.3rem">
          <i class="fas fa-arrow-up"></i>
        </div>
        <div>
          <div style="font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;opacity:.8">Need More?</div>
          <div style="font-size:.9rem;font-weight:700;line-height:1.2;margin-top:.15rem">
            <a href="@Url.Action("SubscriptionOptions","SubscriptionPlan")" style="color:#fff;text-decoration:underline">
              Upgrade Plan
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Recent journeys ────────────────────────────────────── -->
  <div class="card animate-in" style="margin-bottom:1.5rem">
    <div class="card-header bg-info text-white d-flex align-items-center justify-content-between">
      <h5 style="margin:0;font-weight:700;font-size:.95rem">
        <i class="fas fa-history mr-2" style="opacity:.8"></i> Recent Journeys
      </h5>
      <a href="@Url.Action("ViewSelection","College")"
         style="color:rgba(255,255,255,.8);font-size:.8rem;font-weight:600">
        View All <i class="fas fa-arrow-right ml-1"></i>
      </a>
    </div>
    <div class="card-body" style="padding:1.25rem!important">
      <div id="recentJourneysContainer" class="row">
        <div class="col-12 text-center py-4" style="color:var(--text-light)">
          <div class="spinner-ring" style="margin:0 auto 1rem"></div>
          Loading your journeys…
        </div>
      </div>
    </div>
  </div>

  <!-- ── Getting started video ─────────────────────────────── -->
  <div class="card animate-in">
    <div class="card-header bg-primary text-white">
      <h5 style="margin:0;font-weight:700;font-size:.95rem">
        <i class="fas fa-play-circle mr-2" style="opacity:.8"></i> Getting Started
      </h5>
    </div>
    <div class="card-body text-center" style="padding:1.5rem!important">
      <video id="collegeVideo" controls muted
             style="width:100%;max-width:700px;border-radius:var(--r-lg);box-shadow:var(--shadow-lg)">
        <source src="~/Video/CollegeSelection.mp4" type="video/mp4">
        Your browser does not support the video tag.
      </video>
      <p style="color:var(--text-muted);font-size:.8rem;margin-top:.875rem;margin-bottom:0">
        Watch this short guide before starting your college selection process.
      </p>
    </div>
  </div>

</section>

<!-- ── Evaluation detail modal ──────────────────────────────── -->
<div class="modal fade" id="evaluationModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-primary text-white">
        <h5 class="modal-title font-weight-bold">
          <span style="font-size:1.1rem;margin-right:.4rem">✦</span> Evaluation Results
        </h5>
        <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
      </div>
      <div class="modal-body" style="padding:1.5rem!important">
        <div id="evaluationContent"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const video = document.getElementById("collegeVideo");
      if (video) {
        video.addEventListener("play", () => localStorage.setItem("collegeVideoWatched", "true"));
      }
    });

    function loadRecentJourneys() {
      $.ajax({
        url: '/College/GetRecentJourneys',
        type: 'GET',
        success: function (data) {
          const container = $('#recentJourneysContainer');
          container.empty();
          if (data.length > 0) {
            data.forEach(j => {
              const statusBadge = j.status === 'Completed'
                ? '<span class="badge badge-success"><i class="fas fa-check mr-1"></i>Completed</span>'
                : '<span class="badge badge-warning"><i class="fas fa-clock mr-1"></i>In Progress</span>';
              const action = j.status === 'Completed'
                ? `<button class="btn btn-info btn-sm view-evaluation"
                            data-toggle="modal" data-target="#evaluationModal"
                            data-id="${j.id}">
                     <i class="fas fa-eye mr-1"></i> View Results
                   </button>`
                : `<a href="${j.link}" class="btn btn-primary btn-sm">
                     <i class="fas fa-play mr-1"></i> Continue
                   </a>`;
              container.append(`
                <div class="col-md-4 mb-3">
                  <div class="card h-100" style="border-radius:var(--r)!important">
                    <div class="card-body" style="padding:1.125rem!important">
                      <div style="font-weight:700;font-size:.95rem;margin-bottom:.35rem;color:var(--text)">${j.name}</div>
                      <div style="font-size:.75rem;color:var(--text-muted);margin-bottom:.75rem">
                        <i class="fas fa-calendar-alt mr-1"></i> ${j.date}
                      </div>
                      ${statusBadge}
                    </div>
                    <div class="card-footer" style="background:var(--surface-2);padding:.75rem 1.125rem!important;border-top:1px solid var(--border)">
                      ${action}
                    </div>
                  </div>
                </div>`);
            });
          } else {
            container.html(`
              <div class="col-12 text-center py-4" style="color:var(--text-light)">
                <i class="fas fa-route" style="font-size:2.5rem;opacity:.2;display:block;margin-bottom:.75rem"></i>
                No journeys yet. Click <strong>Start New Journey</strong> to begin.
              </div>`);
          }
        },
        error: () => {
          $('#recentJourneysContainer').html('<div class="col-12"><p class="text-center text-danger">Error loading journeys.</p></div>');
        }
      });
    }

    $(document).ready(function () {
      loadRecentJourneys();

      $('#evaluationModal').on('show.bs.modal', function (event) {
        const id = $(event.relatedTarget).data('id');
        $(this).find('#evaluationContent').html(`
          <div style="text-align:center;padding:2rem;color:var(--text-light)">
            <div class="spinner-ring" style="margin:0 auto 1rem"></div> Loading…
          </div>`);
        $.ajax({
          url: '/College/GetEvaluationDetails',
          type: 'GET',
          data: { id },
          success: d => $('#evaluationContent').html(d),
          error: xhr => {
            let msg = 'Error loading details.';
            if (xhr.status === 401) { msg = 'Session expired.'; setTimeout(() => window.location.href='/Account/Login', 1200); }
            else if (xhr.status === 404) { msg = 'Not found.'; }
            $('#evaluationContent').html(`<div class="alert alert-danger">${msg}</div>`);
          }
        });
      });

      $('#evaluationModal').on('hidden.bs.modal', () => $('#evaluationContent').empty());
    });
  </script>
}
