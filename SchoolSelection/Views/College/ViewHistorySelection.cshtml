@model List<SchoolSelection.Models.CollegeFitHistory>

@{
    ViewData["Title"] = "History of College Fit Evaluations";
    Layout = "_BackendLayout";
}

<div class="container">
    <h2 class="mt-4">History of College Fit Evaluations</h2>
    <p class="text-muted">Below is the list of past evaluations for this selection.</p>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No evaluation history found.</div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <table class="table table-striped table-bordered">
                    <thead class="bg-primary text-white">
                    <tr>
                        <th>#</th>
                        <th>Date</th>
                        <th>Evaluated By</th>
                        <th>Evaluation Summary</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <tr>
                            <td>@(i + 1)</td>
                            <td>@Model[i].DateAdded?.ToString("dd MMM yyyy")</td>
                            <td>@Model[i].AddedBy?.FirstName @Model[i].AddedBy?.LastName</td>
                            <td>
                                    <span class="text-truncate" style="max-width: 250px; display: inline-block;">
                                     @System.Text.RegularExpressions.Regex.Replace(Model[i].Result.Substring(0, Math.Min(100, Model[i].Result.Length)), "<.*?>", "") + "..."

                                    </span>
                            </td>
                            <td>
                                <a href="#" class="btn btn-success btn-sm view-result" data-toggle="modal" data-target="#evaluationModal" data-id="@Model[i].Id">
                                    <i class="fa fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Modal for Viewing Full Evaluation -->
<div class="modal fade" id="evaluationModal" tabindex="-1" aria-labelledby="evaluationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="evaluationModalLabel">Evaluation Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="evaluationContent">
                    <!-- Evaluation details will load here dynamically -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).on('click', '.view-result', function () {
            var evaluationId = $(this).data('id');

            // Clear previous content
            $('#evaluationContent').html('<p>Loading...</p>');

            // Fetch evaluation details via AJAX
            $.ajax({
                url: '/College/GetHistoryDetails',
                type: 'GET',
                data: { id: evaluationId },
                success: function (data) {
                    $('#evaluationContent').html(data); // Load returned HTML into modal body
                },
                error: function (xhr) {
                    if (xhr.status === 401) {
                        alert("Your session has expired. Please log in again.");
                        window.location.href = '/Account/Login'; // Redirect to login page
                    } else if (xhr.status === 404) {
                        $('#evaluationContent').html('<p>Evaluation not found.</p>');
                    } else {
                        $('#evaluationContent').html('<p>Error loading evaluation details.</p>');
                    }
                }
            });
        });
    </script>
}
