@using Microsoft.AspNetCore.Mvc.TagHelpers
@model SchoolSelection.ViewModels.EvaluationViewModel

@{
    ViewData["Title"] = "Evaluate Colleges";
    Layout = "_BackendLayout";

    var remainingSubmissions = ViewData["RemainingSubmissions"] as int? ?? 0;
    remainingSubmissions = remainingSubmissions < 0 ? 0 : remainingSubmissions;
    var planType = ViewData["PlanType"] as string;
    string CollegeSelectionId = ViewData["CollegeSelectionId"] as string;
    var CollegeSelectionName = "";

    var getCriteria = await _Context.Criteria.ToListAsync();
    var getSchool   = await _Context.Schools.ToListAsync();
    if (!string.IsNullOrEmpty(CollegeSelectionId))
    {
        var getCollegeSelection = await _Context.CollegeSelections
            .Where(i => i.Id == Guid.Parse(CollegeSelectionId))
            .FirstOrDefaultAsync();
        getCriteria = await _Context.Criteria
            .Where(i => i.CollegeSelectionId == Guid.Parse(CollegeSelectionId))
            .ToListAsync();
        getSchool = await _Context.Schools
            .Where(i => i.CollegeSelectionId == Guid.Parse(CollegeSelectionId))
            .ToListAsync();
        CollegeSelectionName = getCollegeSelection.CollegeSelectionName;
    }
}

<section class="content">
  <div class="wizard-wrapper">

    <!-- ── Wizard steps ──────────────────────────────────── -->
    <div class="wizard-steps">
      <div class="wizard-step completed">
        <div class="wizard-step-circle"><i class="fas fa-check" style="font-size:.7rem"></i></div>
        <div class="wizard-step-label">Name</div>
      </div>
      <div class="wizard-step completed">
        <div class="wizard-step-circle"><i class="fas fa-check" style="font-size:.7rem"></i></div>
        <div class="wizard-step-label">Schools</div>
      </div>
      <div class="wizard-step completed">
        <div class="wizard-step-circle"><i class="fas fa-check" style="font-size:.7rem"></i></div>
        <div class="wizard-step-label">Criteria</div>
      </div>
      <div class="wizard-step active">
        <div class="wizard-step-circle">4</div>
        <div class="wizard-step-label">Evaluate</div>
      </div>
      <div class="wizard-step">
        <div class="wizard-step-circle">5</div>
        <div class="wizard-step-label">AI Result</div>
      </div>
      <div class="wizard-step">
        <div class="wizard-step-circle"><i class="fas fa-flag" style="font-size:.7rem"></i></div>
        <div class="wizard-step-label">Summary</div>
      </div>
    </div>

    <!-- ── Heading ───────────────────────────────────────── -->
    <div class="page-heading">
      <h1>Evaluate Your Schools</h1>
      <p class="lead">Step 4 of 6 &mdash; Rate each school against every criterion.</p>
      @if (!string.IsNullOrEmpty(CollegeSelectionName))
      {
        <p class="journey-name"><i class="fas fa-route mr-1"></i> @CollegeSelectionName</p>
      }
      <hr>
    </div>

    <!-- ── Plan banner ───────────────────────────────────── -->
    <div style="max-width:720px;margin:1.25rem auto 0">
      <div class="plan-banner">
        <div>
          <div class="plan-name"><i class="fas fa-tag mr-1" style="opacity:.8"></i> Plan: @planType</div>
          <div class="plan-remaining">
            @if (remainingSubmissions == 0)
            {
              <span style="color:#fde68a;font-weight:600">
                ⚠ Submission limit reached &mdash;
                <a href="@Url.Action("SubscriptionOptions", "SubscriptionPlan")" style="color:#fde68a;text-decoration:underline">upgrade</a>
              </span>
            }
            else
            {
              <span>@remainingSubmissions AI submission@(remainingSubmissions == 1 ? "" : "s") remaining</span>
            }
          </div>
        </div>
        <button class="btn btn-outline-light btn-sm" type="button"
                data-toggle="collapse" data-target="#planDetails" aria-expanded="false">
          <i class="fas fa-info-circle mr-1"></i> Details
        </button>
      </div>
      <div class="collapse collapse-section" id="planDetails">
        <div style="padding:1rem 1.25rem">
          <p style="margin:0;font-size:.875rem;color:var(--text-muted)">
            Each time you click <strong>"View Your College Fit"</strong> it uses one AI submission from your plan.
            This action is irreversible — make sure all your evaluations are complete before proceeding.
          </p>
        </div>
      </div>
    </div>

    <!-- ── Evaluation form ───────────────────────────────── -->
    <div style="max-width:720px;margin:1.25rem auto 0">
      <div class="card animate-in">
        <div class="card-header bg-primary text-white">
          <h5 style="margin:0;font-weight:700;font-size:.95rem">
            <i class="fas fa-star-half-alt mr-2" style="opacity:.8"></i> Rate a School
          </h5>
        </div>
        <div class="card-body">
          <form asp-action="SubmitEvaluation" method="post">
            <input type="hidden" asp-for="CollegeSelectionId" value="@CollegeSelectionId" />

            <div class="row">
              <div class="col-md-6">
                <div class="form-group mb-3">
                  <label for="schoolDropdown">
                    <i class="fas fa-university mr-1" style="color:var(--primary)"></i> College
                  </label>
                  <select asp-for="SchoolId" class="form-control" id="schoolDropdown" required>
                    <option value="" disabled selected>Select a college…</option>
                    @foreach (var school in getSchool)
                    {
                      <option value="@school.Id">@school.Name</option>
                    }
                  </select>
                </div>
              </div>
              <div class="col-md-6">
                <div class="form-group mb-3">
                  <label for="criteriaDropdown">
                    <i class="fas fa-list-check mr-1" style="color:var(--primary)"></i> Criteria
                  </label>
                  <select asp-for="CriteriaId" class="form-control" id="criteriaDropdown" required>
                    <option value="" disabled selected>Select a criterion…</option>
                    @foreach (var c in getCriteria)
                    {
                      <option value="@c.Id">@c.Name</option>
                    }
                  </select>
                </div>
              </div>
            </div>

            <div class="form-group mb-4">
              <label>
                <i class="fas fa-smile mr-1" style="color:var(--primary)"></i> Satisfaction Level
              </label>
              <div class="rating-group">
                  @foreach (var (level, idx) in new[] {
                  "Very Dissatisfied", "Dissatisfied", "Unsure", "Satisfied", "Very Satisfied"
                }.Select((l, i) => (l, i)))
                  {
                      var isChecked = level == "Satisfied";
                      var inputId = $"sat_{idx}";
                      <input type="radio" asp-for="Satisfaction" value="@level"
                             class="rating-option" id="@inputId" checked="@(isChecked ? "checked" : null)">
                      <label class="rating-label" for="@inputId">@level</label>
                  }
              </div>
            </div>

            <div class="form-group mb-4">
              <label for="notesTextarea">
                <i class="fas fa-sticky-note mr-1" style="color:var(--primary)"></i> Notes
              </label>
              <textarea asp-for="Notes" class="form-control" id="notesTextarea" rows="3"
                        placeholder="Any observations about this school and criterion…"></textarea>
            </div>

            @if (Model.GeneratedSummaries != null && Model.GeneratedSummaries.Any())
            {
              <div class="mb-4">
                <button class="btn btn-info btn-sm" type="button"
                        data-toggle="modal" data-target="#insightsModal">
                  <i class="fas fa-lightbulb mr-1"></i> Show AI Insights
                </button>
              </div>
            }

            <div class="d-flex justify-content-between align-items-center">
              <div style="display:flex;gap:.5rem">
                <button type="button" class="btn btn-secondary"
                        onclick="window.location.href='@Url.Action("CriteriaSelection","College")'">
                  <i class="fas fa-arrow-left mr-1"></i> Back
                </button>
                <button type="submit" class="btn btn-success">
                  <i class="fas fa-save mr-1"></i> Save Rating
                </button>
              </div>
              <button type="button" class="btn btn-primary"
                      onclick="confirmEvaluationSubmission()"
                      @(remainingSubmissions == 0 ? "disabled" : "")>
                <i class="fas fa-robot mr-1"></i> View College Fit
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <!-- ── Submitted evaluations ─────────────────────────── -->
    <div style="max-width:720px;margin:1.25rem auto 2rem">
      <div class="card animate-in">
        <div class="card-header bg-success text-white d-flex align-items-center justify-content-between">
          <h5 style="margin:0;font-weight:700;font-size:.95rem">
            <i class="fas fa-clipboard-check mr-2" style="opacity:.8"></i> Submitted Evaluations
          </h5>
        </div>
        <div class="card-body" style="padding:1rem!important">
          @if (Model.SchoolEvaluations == null || !Model.SchoolEvaluations.Any())
          {
            <div style="text-align:center;padding:2rem;color:var(--text-light)">
              <i class="fas fa-clipboard" style="font-size:2.5rem;opacity:.25;display:block;margin-bottom:.75rem"></i>
              No evaluations saved yet. Use the form above to rate a school.
            </div>
          }
          else
          {
            <ul class="list-group list-group-flush" style="padding:0">
              @foreach (var school in Model.SchoolEvaluations)
              {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                  <div>
                    <div style="font-weight:700;color:var(--text)">@school.SchoolName</div>
                    <small style="color:var(--text-muted)">@string.Join(", ", school.CompletedCriteria)</small>
                  </div>
                  <span class="badge @(school.IsComplete ? "badge-success" : "badge-warning")">
                    @(school.IsComplete ? "✓ Complete" : "In Progress")
                  </span>
                </li>
              }
            </ul>
          }
        </div>
      </div>
    </div>

  </div>

  <!-- ── Confirmation Modal ─────────────────────────────── -->
  <div class="modal fade" id="evaluationConfirmModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
      <div class="modal-content">
        <div class="modal-header bg-warning">
          <h5 class="modal-title font-weight-bold text-dark">
            <i class="fas fa-exclamation-triangle mr-2"></i> Confirm AI Submission
          </h5>
          <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
        </div>
        <div class="modal-body">
          <p>Clicking <strong>"View Your College Fit"</strong> will generate an AI recommendation and use one submission credit.</p>
          <p class="mb-0"><strong>This action cannot be undone.</strong> Have you finished all your evaluations?</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" id="cancelBtn" data-dismiss="modal">Cancel</button>
          <button id="confirmEvaluationBtn" class="btn btn-primary">
            <i class="fas fa-robot mr-1"></i> Yes, Generate Fit
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Insights Modal ────────────────────────────────── -->
  @if (Model.GeneratedSummaries != null && Model.GeneratedSummaries.Any())
  {
    <div class="modal fade" id="insightsModal" tabindex="-1" role="dialog" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
          <div class="modal-header bg-info text-white">
            <h5 class="modal-title font-weight-bold">
              <i class="fas fa-lightbulb mr-2"></i> AI Insights
            </h5>
            <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
          </div>
          <div class="modal-body" style="max-height:60vh;overflow-y:auto;padding:1.5rem">
            @foreach (var summary in Model.GeneratedSummaries)
            {
              <div class="mb-4 pb-3" style="border-bottom:1px solid var(--border)">
                <h6 style="color:var(--primary);font-weight:700">@summary.SchoolName &mdash; @summary.CriteriaName</h6>
                <div class="ai-box">@Html.Raw(summary.Summary)</div>
              </div>
            }
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>
  }

</section>

@section Scripts
{
  <script>
    let evaluationSubmitted = false;

    function confirmEvaluationSubmission() {
      if (!evaluationSubmitted) $('#evaluationConfirmModal').modal('show');
    }

    $(document).ready(function () {
      $('#confirmEvaluationBtn').click(function () {
        if (!evaluationSubmitted) {
          evaluationSubmitted = true;
          $(this).html('<i class="fas fa-spinner fa-spin mr-1"></i> Processing…').prop('disabled', true);
          $('#evaluationConfirmModal').modal('hide');
          setTimeout(() => {
            window.location.href = "@Url.Action("ReviewEvaluations", "College")";
          }, 500);
        }
      });

      $('#cancelBtn, .close').click(function (e) {
        e.preventDefault();
        e.stopPropagation();
        $('#evaluationConfirmModal').modal('hide');
      });
    });
  </script>
}
