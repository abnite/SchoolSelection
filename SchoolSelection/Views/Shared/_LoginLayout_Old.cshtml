<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Page</title>
   <link rel="icon" href="~/images/schoolselection.jpeg" type="image/png">
    <!-- Bootstrap CSS -->
    <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <!-- Custom CSS -->
    <style>
        body {
            /*background-color: #f8f9fa;*/
            background: url("/images/background.jpg") no-repeat center center fixed;
            background-size: cover;
            color: #333;
            font-family: Arial, sans-serif;
                        
        }
        .text-red {
            color: red; /* Ensures that the text is red */
        }

        .wizard-container {
            background-color: #fff;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            padding: 30px;
        }

        .wizard-title {
            text-align: center;
            margin-bottom: 30px;
        }

        .wizard-steps {
            display: flex;
            justify-content: space-between;
            margin-bottom: 30px;
        }

        .wizard-step {
            flex: 1;
            text-align: center;
            font-size: 18px;
            font-weight: bold;
            color: #8f5406; /* Deep gold */
            position: relative;
            cursor: pointer;
        }

            .wizard-step:hover {
                color: #714102; /* Darker gold on hover */
            }

            .wizard-step.active {
                color: #522f03; /* Deep gold */
            }

                .wizard-step.active::after {
                    content: '';
                    position: absolute;
                    bottom: -5px;
                    left: 0;
                    width: 100%;
                    height: 3px;
                    background-color: #8f5406; /* Deep gold */
                }

        .form-group label {
            font-weight: bold;
        }

        .btn-next,
        .btn-prev {
            width: 100px;
            background-color: #8f5406; /* Deep gold */
            border-color: #8f5406; /* Deep gold */
        }

            .btn-next:hover,
            .btn-prev:hover {
                background-color: #714102; /* Darker gold for hover */
                border-color: #714102; /* Darker gold for hover */
            }
    </style>
</head>
<body>
<section class="content-header">
    @{
        if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible" id="DIVHide" style="margin:10px">
                <button class="close" aria-hidden="true" type="button" data-dismiss="alert">×</button>
                <Center><i class="icon fa fa-check"></i>   @TempData["Message"]</Center>

            </div>
        }
        if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible" id="DIVHide" style="margin:10px">
                <button class="close" aria-hidden="true" type="button" data-dismiss="alert">×</button>
                <Center><i class="icon fa fa-check"></i>   @TempData["ErrorMessage"]</Center>

            </div>
        }
    }
</section>
            
<div class="container mt-5">
    <div class="row justify-content-center">
        @RenderBody()
    </div>
</div>

@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
<!-- Bootstrap JS and dependencies -->
<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/popperjs/core@2.5.4/dist/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
<!-- Select2 JS -->
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>


<script>
$(document).ready(function() {
    var currentStep = 1;
    var totalSteps = 3;

    // Initialize the first step
    showStep(currentStep);

    // Next button click event
    $(".btn-next").click(function() {
        // Perform validation on the current step
        if ($("#step" + currentStep + " input, #step" + currentStep + " select").valid()) {
            // If the current step is valid, proceed to the next step
            if(currentStep < totalSteps) {
                currentStep++;
                showStep(currentStep);
                updateWizardSteps(currentStep);
            }
        } else {
            // Focus the first invalid element
            $("#step" + currentStep + " input.error, #step" + currentStep + " select.error").first().focus();
        }
    });

    // Previous button click event
    $(".btn-prev").click(function() {
        if(currentStep > 1) {
            currentStep--;
            showStep(currentStep);
            updateWizardSteps(currentStep);
        }
    });

    // Function to show the current step
    function showStep(step) {
        $("fieldset").hide(); // Hide all steps
        $("#step" + step).show(); // Show the current step
    }

    // Function to update active step in wizard
    function updateWizardSteps(step) {
        $(".wizard-step").removeClass("active");
        $(".wizard-step:nth-child(" + step + ")").addClass("active");
    }
});
</script>
<script>
    $(document).ready(function() {
        // Initialize Select2
        $('.select2').select2({
            placeholder: "Select a country", // Placeholder text
            allowClear: true // Allow clearing the selection
        });
    });
</script>


</body>
</html>
