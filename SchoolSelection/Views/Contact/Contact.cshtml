@{
    ViewBag.Title = "Contact Us";
    Layout = "_BackendLayout";
}

<section class="content">
    <div class="container">
        <!-- Page Header -->
        <div class="row text-center my-5">
            <div class="col-md-12">
                <h1 class="display-4">Contact Us</h1>
                <p class="lead text-muted">We’re here to help! Get in touch with us using the form below or find our contact details.</p>
                <hr style="width: 50%; margin: auto;">
            </div>
        </div>

        <!-- Contact Information and Form Section -->
        <div class="row">
            <!-- Contact Information -->
            <div class="col-md-6 mb-4">
                <div class="card shadow-lg">
                    <div class="card-header bg-primary text-white">
                        <h3 class="card-title">Our Contact Information</h3>
                    </div>
                    <div class="card-body">
                       <!-- <p><i class="fas fa-map-marker-alt text-primary"></i> <strong>Address:</strong> 123 Main Street, Your City, Your Country</p>
                        <p><i class="fas fa-phone text-primary"></i> <strong>Phone:</strong> +123 456 7890</p>-->
                        <p><i class="fas fa-envelope text-primary"></i> <strong>Email:</strong> <a href="mailto:decideconfidently@froootpizza.com
" class="text-primary">decideconfidently@froootpizza.com
                            </a></p>
                        <p><i class="fas fa-clock text-primary"></i> <strong>Working Hours:</strong> Monday - Friday, 9:00 AM - 5:00 PM</p>

                        <!-- Social Media Links -->
                        <hr>
                        <h5>Follow Us</h5>
                        <p>
                            <a href="https://www.facebook.com/share/19anqQ5Fye/?mibextid=wwXIfr" target="_blank" class="text-primary mr-3"><i class="fab fa-facebook-f"></i> Facebook</a>
                           <!-- <a href="https://twitter.com" target="_blank" class="text-primary mr-3"><i class="fab fa-twitter"></i> Twitter</a>-->
                            <a href="https://www.instagram.com/froootpizza/profilecard/?igsh=MWVoMjh2cDdyaWk5cg==" target="_blank" class="text-primary"><i class="fab fa-instagram"></i> Instagram</a>
                        </p>

                        <!-- About Us Section -->
                        <hr>
                        <h5>About Us</h5>
                        <p>
                            We are a customer-focused organization dedicated to providing top-notch services to meet your needs.
                            With years of experience and a passionate team, we aim to deliver excellent solutions and support.
                            Whether you need assistance or have a question, we are here to help.
                        </p>
                        <p>
                            Our mission is to create a lasting impact by offering high-quality products and services
                            that bring value to our clients. Feel free to reach out—we’d love to hear from you!
                        </p>
                    </div>
                </div>
            </div>

            <!-- Contact Form -->
            <div class="col-md-6 mb-4">
                <div class="card shadow-lg">
                    <div class="card-header bg-success text-white">
                        <h3 class="card-title">Send Us a Message</h3>
                    </div>
                    <div class="card-body">
                        <div id="formMessage" class="alert d-none"></div>
                        <form id="contactForm">
                            <div class="form-group">
                                <label for="name">Your Name</label>
                                <input type="text" class="form-control form-control-lg" id="name" name="name" placeholder="Enter your name" required>
                            </div>
                            <div class="form-group">
                                <label for="email">Your Email</label>
                                <input type="email" class="form-control form-control-lg" id="email" name="email" placeholder="Enter your email" required>
                            </div>
                            <div class="form-group">
                                <label for="subject">Subject</label>
                                <input type="text" class="form-control form-control-lg" id="subject" name="subject" placeholder="Enter a subject" required>
                            </div>
                            <div class="form-group">
                                <label for="message">Message</label>
                                <textarea class="form-control form-control-lg" id="message" name="message" rows="5" placeholder="Type your message here" required></textarea>
                            </div>
                            <button type="submit" class="btn btn-success btn-lg btn-block">Submit</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#contactForm').submit(function (e) {
                e.preventDefault();
                const formData = $(this).serialize();
                $('#formMessage').removeClass('alert-success alert-danger').addClass('d-none');

                $.ajax({
                    url: '@Url.Action("SubmitInquiry")', // Ensure the correct action path
                    type: 'POST',
                    data: formData,
                    beforeSend: function () {
                        $('#contactForm button[type="submit"]').prop('disabled', true).text('Submitting...');
                    },
                    success: function (response) {
                        $('#formMessage')
                            .removeClass('d-none alert-danger')
                            .addClass('alert-success')
                            .text('Thank you for your inquiry! We will get back to you soon.')
                            .fadeIn();

                        $('#contactForm')[0].reset();

                        // Hide the message after 10 seconds (10000 milliseconds)
                        setTimeout(function () {
                            $('#formMessage').fadeOut();
                        }, 10000);
                    },
                    error: function (xhr) {
                        $('#formMessage')
                            .removeClass('d-none alert-success')
                            .addClass('alert-danger')
                            .text('An error occurred while submitting your inquiry. Please try again later.')
                            .fadeIn();

                        // Hide the message after 10 seconds (10000 milliseconds)
                        setTimeout(function () {
                            $('#formMessage').fadeOut();
                        }, 10000);
                    },

                    complete: function () {
                        $('#contactForm button[type="submit"]').prop('disabled', false).text('Submit');
                    }
                });
            });
        });
    </script>
}



