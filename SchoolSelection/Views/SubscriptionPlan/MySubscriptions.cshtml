
@model IEnumerable<Subscription>

@{
    ViewBag.Title = "My Subscriptions";
    Layout = "_BackendLayout";
}

<section>
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">My Subscriptions</h3>
        </div>
        <div class="card-body">
            <table id="example1" class="table table-bordered table-hover">
                <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Price</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var subscription in Model)
                {
                    <tr>
                        <td>@subscription.SubscriptionPlan.SubscriptionPlanName</td>
                        <td>@subscription.SubscriptionPlan.Type</td>
                        <td>$@subscription.SubscriptionPlan.Price</td>
                        <td>@subscription.StartDate.ToString("yyyy-MM-dd")</td>
                        <td>@subscription.EndDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (subscription.IsActive)
                            {
                                <span class="badge badge-success">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Expired</span>
                            }
                        </td>
                        <td>
                            @if (subscription.IsActive)
                            {
                                <a asp-action="CancelSubscription" asp-route-id="@subscription.Id" class="btn btn-sm btn-danger"
                                   onclick="return confirm('Are you sure you want to cancel this subscription?');">
                                    <i class="fas fa-times"></i> Cancel
                                </a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>
